msgstr "Odeslat žádost o funkci"

#: build/admin.js:59
msgid "Explore the Roadmap"
msgstr "Prozkoumejte plán vývoje"

#: build/admin.js:59
msgid "Got it, close this tour"
msgstr "Rozumím, zavřít tuto prohlídku"

#: build/admin.js:66
#: build/public.js:1
msgid "Legal information"
msgstr "Právní informace"

#: build/admin.js:66
