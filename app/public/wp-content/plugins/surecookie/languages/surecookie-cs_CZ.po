msgstr "Přenášeno mimo EU/EHP"

#: build/admin.js:96
#: build/onboarding.js:6
msgid "Scanning is paused on this site"
msgstr "Skenování na tomto webu je pozastaveno"

#: build/admin.js:96
#: build/onboarding.js:6
msgid "Your site's built-in scheduler (WP-Cron) is switched off, and SureCookie needs it to run a scan. Ask your host to turn WP-Cron back on, or to add a server cron job. Everything else works normally, and you can scan as soon as it is back."
msgstr "Vestavěný plánovač vašeho webu (WP-Cron) je vypnutý a SureCookie ho potřebuje ke spuštění skenování. Požádejte svého poskytovatele hostingu, aby WP-Cron znovu zapnul, nebo přidal serverový cron úkol. Vše ostatní funguje normálně a můžete skenovat, jakmile bude zpět."

#: build/admin.js:99
msgid "Linked from the preferences modal, so visitors can reach it while the consent prompt is open. Order and visibility live under Banner > Content."
msgstr "Propojeno z modálního okna preferencí, aby k němu návštěvníci mohli přistoupit, když je otevřený výzva k souhlasu. Pořadí a viditelnost jsou pod Banner > Obsah."

#: build/admin.js:102
msgid "Leave it empty if none of them applies."
msgstr "Nechte prázdné, pokud se na žádný z nich nevztahuje."

#: build/onboarding.js:6
msgid "Your session has expired. Reload the page, then activate your license again."
msgstr "Vaše relace vypršela. Znovu načtěte stránku a poté znovu aktivujte svou licenci."

#: build/onboarding.js:6
msgid "We couldn't find that license key. Check it for typos, or copy it again from your SureCookie account."
msgstr "Tu licenci jsme nenašli. Zkontrolujte překlepy nebo ji zkopírujte znovu ze svého účtu SureCookie."

#: build/onboarding.js:6
msgid "That license has expired. Renew it in your SureCookie account, then activate again."
msgstr "Tato licence vypršela. Obnovte ji ve svém účtu SureCookie a poté znovu aktivujte."

#: build/onboarding.js:6
msgid "That license is already active on the maximum number of sites. Deactivate it on a site you no longer use, or upgrade your plan."
msgstr "Tato licence je již aktivní na maximálním počtu webů. Deaktivujte ji na webu, který již nepoužíváte, nebo upgradujte svůj plán."

#: build/onboarding.js:6
msgid "Visiting your pages…"
msgstr "Návštěva vašich stránek…"

#: build/onboarding.js:6
msgid "Sorting the cookies we found…"
msgstr "Třídím nalezené cookies…"

#: build/onboarding.js:6
msgid "Preparing the scan…"
msgstr "Připravuji skenování…"

#. translators: 1: pages scanned so far, 2: total pages
#: build/onboarding.js:7
#, js-format
msgid "%1$d of %2$d pages"
msgstr "%1$d z %2$d stránek"

#: build/onboarding.js:7
msgid "This runs on our servers, so you can continue setup now. The scan keeps going in the background and the results appear under Tracking Manager when it finishes."
msgstr "Toto běží na našich serverech, takže můžete pokračovat v nastavení. Skenování pokračuje na pozadí a výsledky se objeví v Správci sledování, jakmile skončí."

#: build/onboarding.js:7
msgid "Stopping…"
msgstr "Zastavuji…"

#: build/onboarding.js:7
msgid "Stop Scan"
msgstr "Zastavit skenování"

#: build/onboarding.js:7
msgid "Collecting the results…"
msgstr "Sbírám výsledky…"

#. translators: %d: number of cookies found
#: build/onboarding.js:8
#, js-format
msgid "We found %d cookie on your site"
msgid_plural "We found %d cookies on your site"
msgstr[0] "Na vašem webu jsme našli %d cookie"
msgstr[1] "Na vašem webu jsme našli %d cookies"
msgstr[2] "Na vašem webu jsme našli %d cookies"

#: build/onboarding.js:8
msgid "Each one is sorted into a category so the banner can hold it back until a visitor agrees. You can review and change any of this later under Tracking Manager."
msgstr "Každá je zařazena do kategorie, aby ji banner mohl zadržet, dokud návštěvník nesouhlasí. Toto můžete později zkontrolovat a změnit ve Správci sledování."

#: build/onboarding.js:9
msgid "Connect your account instead"
msgstr "Místo toho připojte svůj účet"

#: build/onboarding.js:13
msgid "Your Privacy Scan"
msgstr "Váš sken ochrany soukromí"

#: build/onboarding.js:13
msgid "SureCookie is checking the pages you chose."
msgstr "SureCookie kontroluje vybrané stránky."

#: build/onboarding.js:13
msgid "This is what SureCookie found on the pages you chose."
msgstr "Toto SureCookie našel na vybraných stránkách."

#: build/onboarding.js:13
msgid "Please <a>go back</a> and add your license key, or connect your SureCookie account, to enable cookie scanning."
msgstr "Prosím, <a>vraťte se zpět</a> a přidejte svůj licenční klíč nebo připojte svůj účet SureCookie, aby bylo možné povolit skenování cookies."

#: build/onboarding.js:16
msgid "Continue"
msgstr "Pokračovat"

#: build/onboarding.js:16
msgid "SureCookie is visiting your selected pages. The results appear here as soon as it finishes."
msgstr "SureCookie navštěvuje vybrané stránky. Výsledky se zde objeví, jakmile skenování skončí."

#: build/onboarding.js:16
msgid "Add a Cookie Preferences link"
msgstr "Přidat odkaz na nastavení cookies"

#: build/onboarding.js:16
msgid "Your theme has no classic menus, so add this shortcode to a footer block or widget area:"
msgstr "Vaše téma nemá klasická menu, přidejte proto tento shortcode do patičkového bloku nebo oblasti widgetů:"

#: build/onboarding.js:16
msgid "Copy the shortcode manually"
msgstr "Zkopírujte shortcode ručně"

#: build/onboarding.js:16
msgid "Copy Shortcode"
msgstr "Zkopírovat shortcode"
