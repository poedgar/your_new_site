msgstr "Nie zablokowane"

#: build/admin.js:97
msgid "Whitelisted"
msgstr "Na białej liście"

#: build/admin.js:97
msgid "Managed by GCM"
msgstr "Zarządzane przez GCM"

#: build/admin.js:97
msgid "Source"
msgstr "Źródło"

#: build/admin.js:97
msgid "Managed via Known Services - its cookies are declared in your cookie policy."
msgstr "Zarządzane przez Znane Usługi – jego ciasteczka są zadeklarowane w Twojej polityce ciasteczek."

#: build/admin.js:97
msgid "Recognized Known Services catalog entry - Click \"Add as Service\" to declare its cookies."
msgstr "Rozpoznany wpis katalogowy Znanych Usług – kliknij „Dodaj jako usługę”, aby zadeklarować jego ciasteczka."

#: build/admin.js:97
msgid "Managed Service"
msgstr "Zarządzana usługa"

#: build/admin.js:97
