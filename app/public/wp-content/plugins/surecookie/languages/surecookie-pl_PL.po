#: build/admin.js:79
#: build/onboarding.js:4
msgid "Could not copy"
msgstr "Nie można skopiować"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Copy the value manually."
msgstr "Skopiuj wartość ręcznie."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "We Could Not Verify Your Domain"
msgstr "Nie mogliśmy zweryfikować Twojej domeny"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Verify With a DNS Record Instead"
msgstr "Zweryfikuj zamiast tego za pomocą rekordu DNS"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Add this TXT record at your DNS provider, then retry. This proves you own the domain without us needing to reach your site, so a firewall cannot block it."
msgstr "Dodaj ten rekord TXT u swojego dostawcy DNS, a następnie spróbuj ponownie. To potwierdza, że jesteś właścicielem domeny, bez konieczności dostępu do Twojej strony, więc zapora sieciowa nie może tego zablokować."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Domain verified"
msgstr "Domena zweryfikowana"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Still not verified"
msgstr "Wciąż niezweryfikowana"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes can take a while to propagate. Try again shortly."
msgstr "Zmiany DNS mogą chwilę potrwać, zanim się rozpropagują. Spróbuj ponownie za chwilę."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Retry Verification"
msgstr "Ponów weryfikację"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes usually apply within minutes, but can take up to a day."
msgstr "Zmiany DNS zwykle stosują się w ciągu kilku minut, ale mogą potrwać do dnia."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Session Expired"
msgstr "Sesja wygasła"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your session or license changed since this page loaded. Reload the page to reconnect, then start the scan again."
msgstr "Twoja sesja lub licencja zmieniły się od momentu załadowania tej strony. Przeładuj stronę, aby się ponownie połączyć, a następnie rozpocznij skanowanie od nowa."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Site Verification Failed"
msgstr "Weryfikacja strony nie powiodła się"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scanning service could not reach your site to verify it. A firewall, security plugin, or SSL problem is the usual cause. Check those and try again."
msgstr "Usługa skanowania nie mogła uzyskać dostępu do Twojej strony, aby ją zweryfikować. Zwykle przyczyną jest zapora sieciowa, wtyczka zabezpieczająca lub problem z SSL. Sprawdź to i spróbuj ponownie."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Couldn't Reach the Scanner"
msgstr "Nie można połączyć się ze skanerem"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your site could not reach the scanning service. Check your connection and try again. Any cookies already found are saved."
msgstr "Twoja strona nie mogła połączyć się z usługą skanowania. Sprawdź połączenie i spróbuj ponownie. Wszystkie znalezione ciasteczka zostały zapisane."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "No Pages Left to Scan"
msgstr "Brak stron do zeskanowania"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The pages you selected are no longer published, so there was nothing to scan. Choose your pages again and start a new scan."
msgstr "Wybrane strony nie są już opublikowane, więc nie było czego skanować. Wybierz strony ponownie i rozpocznij nowe skanowanie."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Already Running"
msgstr "Skanowanie już trwa"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "A scan is already running on this site. Wait for it to finish, then start the next one. If nothing appears to be running, reload the page and try again."
msgstr "Skanowanie na tej stronie już trwa. Poczekaj na jego zakończenie, a następnie rozpocznij kolejne. Jeśli nic się nie dzieje, przeładuj stronę i spróbuj ponownie."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Started"
msgstr "Nie można rozpocząć skanowania"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "SureCookie could not start the scan, usually a temporary problem reaching the scanning service. Any cookies already found are saved. Please try again in a moment."
msgstr "SureCookie nie mógł rozpocząć skanowania, zwykle z powodu tymczasowego problemu z połączeniem z usługą skanowania. Wszystkie znalezione ciasteczka zostały zapisane. Proszę spróbuj ponownie za chwilę."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scan request was rejected before it started. Reload the page and try again."
msgstr "Żądanie skanowania zostało odrzucone przed rozpoczęciem. Przeładuj stronę i spróbuj ponownie."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scanning Needs SureCookie Pro"
msgstr "Skanowanie wymaga SureCookie Pro"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "This scan is a Pro feature. Upgrade to run it, or carry on with the cookies already found."
msgstr "To skanowanie jest funkcją Pro. Uaktualnij, aby je uruchomić, lub kontynuuj z już znalezionymi ciasteczkami."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Daily Scan Limit Reached"
msgstr "Osiągnięto dzienny limit skanowań"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "You have used every scan allowed today. Any cookies already found are saved, and you can scan again once the limit resets."
msgstr "Wykorzystałeś wszystkie dozwolone dzisiaj skanowania. Wszystkie znalezione ciasteczka zostały zapisane, a skanować możesz ponownie po zresetowaniu limitu."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Any cookies already found have been saved, and results add up across scans, so nothing is lost. Please try again in a moment."
msgstr "Wszystkie znalezione ciasteczka zostały zapisane, a wyniki sumują się między skanowaniami, więc nic nie zostanie utracone. Proszę spróbuj ponownie za chwilę."

