#: build/admin.js:97
msgid "Script & Iframe"
msgstr "Skrypt i iFrame"

#: build/admin.js:97
msgid "Blocked until consent"
msgstr "Zablokowane do czasu wyrażenia zgody"

#: build/admin.js:97
