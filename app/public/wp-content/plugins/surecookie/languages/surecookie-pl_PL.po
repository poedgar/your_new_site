#: build/onboarding.js:8
#, js-format
msgid "We found %d cookie on your site"
msgid_plural "We found %d cookies on your site"
msgstr[0] "Znaleźliśmy %d plik cookie na Twojej stronie"
msgstr[1] "Znaleźliśmy %d pliki cookie na Twojej stronie"
msgstr[2] "Znaleźliśmy %d plików cookie na Twojej stronie"

#: build/onboarding.js:8
msgid "Each one is sorted into a category so the banner can hold it back until a visitor agrees. You can review and change any of this later under Tracking Manager."
msgstr "Każdy z nich jest przypisany do kategorii, aby baner mógł go zablokować, dopóki odwiedzający nie wyrazi zgody. Możesz to później przeglądać i zmieniać w Menedżerze śledzenia."

#: build/onboarding.js:9
msgid "Connect your account instead"
msgstr "Zamiast tego połącz swoje konto"

#: build/onboarding.js:13
msgid "Your Privacy Scan"
msgstr "Twoje skanowanie prywatności"

#: build/onboarding.js:13
msgid "SureCookie is checking the pages you chose."
msgstr "SureCookie sprawdza wybrane przez Ciebie strony."

#: build/onboarding.js:13
msgid "This is what SureCookie found on the pages you chose."
msgstr "Oto, co SureCookie znalazł na wybranych przez Ciebie stronach."

#: build/onboarding.js:13
msgid "Please <a>go back</a> and add your license key, or connect your SureCookie account, to enable cookie scanning."
msgstr "Proszę <a>wróć</a> i dodaj klucz licencyjny lub połącz konto SureCookie, aby włączyć skanowanie plików cookie."

