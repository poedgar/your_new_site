#: build/admin.js:88
#, js-format
msgid "%1$dh %2$dm"
msgstr "%1$dg %2$dm"

#. translators: %d: minutes remaining.
#: build/admin.js:89
#, js-format
msgid "%dm"
msgstr "%dm"

#: build/admin.js:96
msgid "<p>By scanning you accept our <a>Terms and Conditions</a>.</p>"
msgstr "<p>Przez skanowanie akceptujesz nasze <a>Warunki korzystania</a>.</p>"

#: build/admin.js:96
msgid "Unlock Geo Rules, Advanced Scanning & more with SureCookie Premium."
msgstr "Odblokuj reguły geograficzne, zaawansowane skanowanie i więcej z SureCookie Premium."

#: build/admin.js:97
msgid "Cannot be blocked"
msgstr "Nie można zablokować"

#: build/admin.js:97
msgid "SureCookie cannot block this resource. It loads as an image, and blocking only rewrites script, iframe, embed, object and link tags."
msgstr "SureCookie nie może zablokować tego zasobu. Ładuje się jako obraz, a blokowanie dotyczy tylko przepisania tagów skryptów, iframe, embed, object i link."

#: build/admin.js:97
msgid "This resource is in a category that is never held back, so it loads before consent. Move it to another category to have it blocked."
msgstr "Ten zasób znajduje się w kategorii, która nigdy nie jest blokowana, więc ładuje się przed wyrażeniem zgody. Przenieś go do innej kategorii, aby go zablokować."

#: build/admin.js:97
msgid "Always load"
msgstr "Zawsze ładuj"

#: build/admin.js:97
msgid "SureCookie stops managing this resource, in the page and in the browser. Use this when it must load before consent."
msgstr "SureCookie przestaje zarządzać tym zasobem, na stronie i w przeglądarce. Użyj tego, gdy zasób musi się załadować przed wyrażeniem zgody."

#: build/admin.js:97
msgid "SureCookie stops managing anything matching this rule, in the page and in the browser. Use this when it must load before consent."
msgstr "SureCookie przestaje zarządzać wszystkim, co pasuje do tej reguły, na stronie i w przeglądarce. Użyj tego, gdy zasób musi się załadować przed wyrażeniem zgody."

#: build/admin.js:97
msgid "Block until consent"
msgstr "Blokuj do czasu zgody"

#: build/admin.js:98
msgid "Allowed to load while Google Consent Mode is active, instead of being blocked before consent. Tag Manager is one of them."
msgstr "Dozwolone ładowanie podczas aktywnego trybu zgody Google, zamiast blokowania przed wyrażeniem zgody. Tag Manager jest jednym z nich."

#: build/admin.js:98
msgid "These Google services are allowed to load while Google Consent Mode is active, instead of being blocked before consent. For Google tag products, Consent Mode then controls what they may store and which identifiers they may use. It does not stop them from contacting Google. Google Tag Manager is on this list, and Consent Mode does not reach the non-Google tags you deploy through it, so each of those needs its own consent check inside Tag Manager. They cannot be removed here."
msgstr "Te usługi Google mogą się ładować podczas aktywnego trybu zgody Google, zamiast być blokowane przed wyrażeniem zgody. W przypadku produktów Google Tag tryb zgody kontroluje, co mogą przechowywać i jakich identyfikatorów mogą używać. Nie zatrzymuje to ich kontaktu z Google. Google Tag Manager jest na tej liście, a tryb zgody nie obejmuje tagów niepochodzących od Google, które wdrażasz przez niego, więc każdy z nich wymaga własnej kontroli zgody w Tag Managerze. Nie można ich usunąć tutaj."

#: build/admin.js:98
msgid "Choose scripts and domains that should never be blocked, so essential integrations like Stripe or Cloudflare Turnstile keep working. Google Consent Mode scripts are whitelisted automatically when it is enabled."
msgstr "Wybierz skrypty i domeny, które nigdy nie powinny być blokowane, aby kluczowe integracje, takie jak Stripe lub Cloudflare Turnstile, działały poprawnie. Skrypty trybu zgody Google są automatycznie dodawane do białej listy, gdy jest on włączony."

