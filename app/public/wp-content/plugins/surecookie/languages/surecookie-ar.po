#: build/admin.js:115
msgid "Enter placeholder text"
msgstr "أدخل نص العنصر النائب"

#: build/admin.js:115
msgid "Use {service} to insert the blocked service name (e.g. YouTube)."
msgstr "استخدم {service} لإدخال اسم الخدمة المحظورة (مثل YouTube)."

#: build/admin.js:115
msgid "Button Text"
msgstr "نص الزر"

#: build/admin.js:118
msgid "Allow AI clients like Claude, and Cursor to manage your cookie banner, scanner, and consent settings through SureCookie. When disabled, no abilities are registered and AI clients cannot connect."
msgstr "اسمح لعملاء الذكاء الاصطناعي مثل Claude وCursor بإدارة لافتة ملفات تعريف الارتباط، والمفحص، وإعدادات الموافقة الخاصة بك من خلال SureCookie. عند تعطيله، لا يتم تسجيل أي قدرات ولا يمكن للعملاء الاتصال."

#: build/admin.js:118
#: build/admin.js:120
msgid "All Settings"
msgstr "جميع الإعدادات"

#: build/admin.js:118
msgid "Your entire portable configuration in one file."
msgstr "كل تكوينك المحمول في ملف واحد."

#: build/admin.js:118
msgid "Nothing imported"
msgstr "لم يتم استيراد شيء"

#: build/admin.js:118
msgid "Import complete"
msgstr "اكتمل الاستيراد"

#: build/admin.js:118
msgid "None of the settings in this file could be applied to this site."
msgstr "لم يتم تطبيق أي من الإعدادات في هذا الملف على هذا الموقع."

#: build/admin.js:118
msgid "Your settings were imported. Here is what happened:"
msgstr "تم استيراد إعداداتك. هذا ما حدث:"

#: build/admin.js:118
msgid "Applied"
msgstr "تم التطبيق"

#: build/admin.js:118
msgid "Skipped (Pro)"
msgstr "تم التخطي (Pro)"

#: build/admin.js:118
msgid "Ignored"
msgstr "تم التجاهل"

#: build/admin.js:120
msgid "These settings need SureCookie Pro"
msgstr "تحتاج هذه الإعدادات إلى SureCookie Pro"

#: build/admin.js:120
msgid "Upgrade to Pro to use the skipped features on this site."
msgstr "قم بالترقية إلى Pro لاستخدام الميزات التي تم تخطيها على هذا الموقع."

#: build/admin.js:120
msgid "Move your SureCookie setup between sites with a portable settings export."
msgstr "انقل إعداد SureCookie الخاص بك بين المواقع باستخدام تصدير إعدادات محمول."

#: build/admin.js:120
msgid "Export settings"
