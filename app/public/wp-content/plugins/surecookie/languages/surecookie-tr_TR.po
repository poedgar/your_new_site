#: build/admin.js:79
#: build/onboarding.js:4
msgid "We Could Not Verify Your Domain"
msgstr "Alan Adınızı Doğrulayamadık"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Verify With a DNS Record Instead"
msgstr "Bunun Yerine DNS Kaydı ile Doğrulayın"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Add this TXT record at your DNS provider, then retry. This proves you own the domain without us needing to reach your site, so a firewall cannot block it."
msgstr "DNS sağlayıcınıza bu TXT kaydını ekleyin, ardından tekrar deneyin. Bu, alan adının size ait olduğunu kanıtlar ve sitenize erişmemize gerek kalmaz, böylece bir güvenlik duvarı engelleyemez."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Domain verified"
msgstr "Alan adı doğrulandı"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Still not verified"
msgstr "Hâlâ doğrulanmadı"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes can take a while to propagate. Try again shortly."
msgstr "DNS değişikliklerinin yayılması biraz zaman alabilir. Kısa süre içinde tekrar deneyin."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Retry Verification"
msgstr "Doğrulamayı Tekrar Dene"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes usually apply within minutes, but can take up to a day."
msgstr "DNS değişiklikleri genellikle dakikalar içinde uygulanır, ancak bir güne kadar sürebilir."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Session Expired"
msgstr "Oturum Süresi Doldu"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your session or license changed since this page loaded. Reload the page to reconnect, then start the scan again."
msgstr "Bu sayfa yüklendiğinden beri oturumunuz veya lisansınız değişti. Yeniden bağlanmak için sayfayı yenileyin, ardından taramayı tekrar başlatın."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Site Verification Failed"
msgstr "Site Doğrulaması Başarısız"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scanning service could not reach your site to verify it. A firewall, security plugin, or SSL problem is the usual cause. Check those and try again."
msgstr "Tarama servisi sitenize ulaşarak doğrulama yapamadı. Genellikle bir güvenlik duvarı, güvenlik eklentisi veya SSL sorunu neden olur. Bunları kontrol edin ve tekrar deneyin."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Couldn't Reach the Scanner"
msgstr "Tarayıcıya Ulaşılamadı"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your site could not reach the scanning service. Check your connection and try again. Any cookies already found are saved."
msgstr "Siteniz tarama servisine ulaşamadı. Bağlantınızı kontrol edin ve tekrar deneyin. Zaten bulunan çerezler kaydedildi."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "No Pages Left to Scan"
msgstr "Tarama İçin Sayfa Kalmadı"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The pages you selected are no longer published, so there was nothing to scan. Choose your pages again and start a new scan."
msgstr "Seçtiğiniz sayfalar artık yayınlanmıyor, bu yüzden taranacak bir şey yoktu. Sayfalarınızı tekrar seçin ve yeni bir tarama başlatın."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Already Running"
msgstr "Tarama Zaten Çalışıyor"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "A scan is already running on this site. Wait for it to finish, then start the next one. If nothing appears to be running, reload the page and try again."
msgstr "Bu sitede zaten bir tarama çalışıyor. Bitmesini bekleyin, sonra yenisini başlatın. Hiçbir şey çalışmıyormuş gibi görünüyorsa, sayfayı yenileyin ve tekrar deneyin."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Started"
msgstr "Tarama Başlatılamadı"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "SureCookie could not start the scan, usually a temporary problem reaching the scanning service. Any cookies already found are saved. Please try again in a moment."
msgstr "SureCookie taramayı başlatamadı, genellikle tarama servisine geçici erişim sorunu vardır. Zaten bulunan çerezler kaydedildi. Lütfen bir süre sonra tekrar deneyin."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scan request was rejected before it started. Reload the page and try again."
msgstr "Tarama isteği başlamadan reddedildi. Sayfayı yenileyin ve tekrar deneyin."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scanning Needs SureCookie Pro"
msgstr "Tarama İçin SureCookie Pro Gerekiyor"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "This scan is a Pro feature. Upgrade to run it, or carry on with the cookies already found."
msgstr "Bu tarama Pro özelliğidir. Çalıştırmak için yükseltin veya zaten bulunan çerezlerle devam edin."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Daily Scan Limit Reached"
msgstr "Günlük Tarama Limiti Doldu"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "You have used every scan allowed today. Any cookies already found are saved, and you can scan again once the limit resets."
msgstr "Bugün izin verilen tüm taramaları kullandınız. Zaten bulunan çerezler kaydedildi ve limit sıfırlandığında tekrar tarama yapabilirsiniz."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Any cookies already found have been saved, and results add up across scans, so nothing is lost. Please try again in a moment."
msgstr "Zaten bulunan çerezler kaydedildi ve sonuçlar taramalar arasında toplanır, böylece hiçbir şey kaybolmaz. Lütfen bir süre sonra tekrar deneyin."

