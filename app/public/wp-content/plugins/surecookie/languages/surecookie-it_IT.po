msgstr "Ogni sezione della pagina generata è un proprio shortcode, quindi puoi eliminarle, riordinarle o inserirle in una pagina che hai scritto tu. Renderizzano sempre le tue impostazioni attuali."

#: build/admin.js:107
msgid "Scan your site as a real visitor would do"
msgstr "Scansiona il tuo sito come farebbe un visitatore reale"

#: build/admin.js:107
msgid "See what loads before and after consent"
msgstr "Vedi cosa si carica prima e dopo il consenso"

#: build/admin.js:107
msgid "Detect scripts and trackers firing too early"
msgstr "Individua script e tracker che si attivano troppo presto"

#: build/admin.js:107
