msgstr "Esta varredura é um recurso Pro. Atualize para executá-la ou continue com os cookies já encontrados."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Daily Scan Limit Reached"
msgstr "Limite Diário de Varreduras Atingido"

#: build/admin.js:83
#: build/onboarding.js:16
