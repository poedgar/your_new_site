#: inc/services/known-services-service.php:172
msgid "Service installed. Every cookie it declares was already present, so no new cookie definitions were created."
msgstr "Serviço instalado. Todos os cookies que ele declara já estavam presentes, então nenhuma nova definição de cookie foi criada."

#: inc/services/known-services-service.php:173
msgid "Service installed and its cookies declared."
msgstr "Serviço instalado e seus cookies declarados."

#: inc/services/known-services-service.php:208
msgid "Service removed and its declared cookies deleted."
msgstr "Serviço removido e seus cookies declarados excluídos."

#: inc/services/known-services-service.php:209
