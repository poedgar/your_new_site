msgid "Retry Verification"
msgstr "Försök verifiera igen"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes usually apply within minutes, but can take up to a day."
msgstr "DNS-ändringar brukar gälla inom några minuter, men kan ta upp till en dag."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Session Expired"
msgstr "Sessionen har gått ut"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your session or license changed since this page loaded. Reload the page to reconnect, then start the scan again."
msgstr "Din session eller licens har ändrats sedan sidan laddades. Ladda om sidan för att återansluta och starta sedan skanningen igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Site Verification Failed"
msgstr "Verifiering av webbplats misslyckades"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scanning service could not reach your site to verify it. A firewall, security plugin, or SSL problem is the usual cause. Check those and try again."
msgstr "Skanningstjänsten kunde inte nå din webbplats för att verifiera den. En brandvägg, säkerhetsplugin eller SSL-problem är vanligtvis orsaken. Kontrollera dessa och försök igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Couldn't Reach the Scanner"
msgstr "Kunde inte nå skannern"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your site could not reach the scanning service. Check your connection and try again. Any cookies already found are saved."
msgstr "Din webbplats kunde inte nå skanningstjänsten. Kontrollera din anslutning och försök igen. Eventuella redan hittade cookies sparas."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "No Pages Left to Scan"
msgstr "Inga sidor kvar att skanna"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The pages you selected are no longer published, so there was nothing to scan. Choose your pages again and start a new scan."
msgstr "De sidor du valde är inte längre publicerade, så det fanns inget att skanna. Välj dina sidor igen och starta en ny skanning."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Already Running"
msgstr "Skanning pågår redan"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "A scan is already running on this site. Wait for it to finish, then start the next one. If nothing appears to be running, reload the page and try again."
msgstr "En skanning pågår redan på denna webbplats. Vänta tills den är klar och starta sedan nästa. Om inget verkar pågå, ladda om sidan och försök igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Started"
msgstr "Skanning kunde inte startas"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "SureCookie could not start the scan, usually a temporary problem reaching the scanning service. Any cookies already found are saved. Please try again in a moment."
msgstr "SureCookie kunde inte starta skanningen, vanligtvis ett tillfälligt problem med att nå skanningstjänsten. Eventuella redan hittade cookies sparas. Försök igen om en stund."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scan request was rejected before it started. Reload the page and try again."
msgstr "Skanningsförfrågan avvisades innan den startade. Ladda om sidan och försök igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scanning Needs SureCookie Pro"
msgstr "Skanning kräver SureCookie Pro"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "This scan is a Pro feature. Upgrade to run it, or carry on with the cookies already found."
msgstr "Denna skanning är en Pro-funktion. Uppgradera för att köra den, eller fortsätt med de cookies som redan hittats."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Daily Scan Limit Reached"
msgstr "Daglig skanningsgräns nådd"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "You have used every scan allowed today. Any cookies already found are saved, and you can scan again once the limit resets."
msgstr "Du har använt alla tillåtna skanningar idag. Eventuella redan hittade cookies sparas, och du kan skanna igen när gränsen återställs."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Any cookies already found have been saved, and results add up across scans, so nothing is lost. Please try again in a moment."
msgstr "Eventuella redan hittade cookies har sparats, och resultaten läggs ihop över skanningar, så inget går förlorat. Försök igen om en stund."

