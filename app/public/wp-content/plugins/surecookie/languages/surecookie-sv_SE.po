#: build/admin.js:103
msgid "Legal entity name and registered address from Business Details."
msgstr "Juridiskt namn och registrerad adress från företagsuppgifter."

#: build/admin.js:103
msgid "Privacy contact address, rendered as a link."
msgstr "Sekretesskontaktadress, visas som en länk."

#: build/admin.js:103
msgid "Two dates: when the policy was last edited, and when the cookie list was last refreshed."
msgstr "Två datum: när policyn senast redigerades och när cookielistan senast uppdaterades."

#: build/admin.js:103
msgid "Situational"
msgstr "Situationsberoende"

#: build/admin.js:103
