msgstr[0] "Мы нашли %d cookie на вашем сайте"
msgstr[1] "Мы нашли %d файла cookie на вашем сайте"
msgstr[2] "Мы нашли %d файлов cookie на вашем сайте"

#: build/onboarding.js:8
msgid "Each one is sorted into a category so the banner can hold it back until a visitor agrees. You can review and change any of this later under Tracking Manager."
msgstr "Каждый из них сортируется по категории, чтобы баннер мог блокировать его до согласия посетителя. Вы можете просмотреть и изменить это позже в разделе «Менеджер отслеживания»."

#: build/onboarding.js:9
msgid "Connect your account instead"
msgstr "Вместо этого подключите свой аккаунт"

#: build/onboarding.js:13
msgid "Your Privacy Scan"
msgstr "Ваш сканер конфиденциальности"

#: build/onboarding.js:13
