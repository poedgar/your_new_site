#: inc/api/cookies.php:460
msgid "Failed to remove service cookies: "
msgstr "נכשל בהסרת עוגיות שירות:"

#: inc/integrations/site-health/init.php:69
msgid "Visitor identification"
msgstr "זיהוי מבקר"

#: inc/integrations/site-health/init.php:87
msgid "SureCookie can identify your visitors"
msgstr "SureCookie יכול לזהות את המבקרים שלך"

#: inc/integrations/site-health/consent-write.php:104
#: inc/integrations/site-health/init.php:90
msgid "Privacy"
msgstr "פרטיות"

#: inc/integrations/site-health/init.php:93
msgid "Visitor addresses reach SureCookie directly, so geographic rules, consent-log countries and per-visitor rate limits all describe the real visitor."
msgstr "כתובות המבקרים מגיעות ישירות ל-SureCookie, כך שכללי גאוגרפיה, מדינות ברישומי הסכמה ומגבלות קצב לכל מבקר מתארים את המבקר האמיתי."

#: inc/integrations/site-health/init.php:103
msgid "SureCookie sees your proxy instead of your visitors"
msgstr "SureCookie רואה את הפרוקסי שלך במקום את המבקרים שלך"

#: inc/integrations/site-health/init.php:106
msgid "Requests reach this site through a CDN, so every address SureCookie resolves belongs to the CDN edge rather than to your visitor."
msgstr "בקשות מגיעות לאתר זה דרך CDN, כך שכל כתובת ש-SureCookie מפענח שייכת לקצה ה-CDN ולא למבקר שלך."

#: inc/integrations/site-health/init.php:107
msgid "Requests reach this site through a reverse proxy, so every address SureCookie resolves belongs to that proxy rather than to your visitor."
msgstr "בקשות מגיעות לאתר זה דרך פרוקסי הפוך, כך שכל כתובת ש-SureCookie מפענח שייכת לפרוקסי ההפוך ולא למבקר שלך."

#: inc/integrations/site-health/init.php:109
msgid "Three things are affected: geographic rules resolve the wrong country, so a visitor can be shown the wrong consent model; consent logs record that wrong country; and the per-visitor rate limits collapse into one shared bucket."
msgstr "שלושה דברים מושפעים: כללי גאוגרפיה מפענחים את המדינה הלא נכונה, כך שמבקר יכול להראות מודל הסכמה שגוי; רישומי הסכמה מתעדים את המדינה השגויה; ומגבלות הקצב לכל מבקר מתמזגות לדלי משותף אחד."

#: inc/integrations/site-health/init.php:164
msgid "Forwarded headers are already trusted from a recognised proxy, and only X-Forwarded-For is read. Your CDN is either not sending that header or is sending its own instead, so name the header it overwrites on every request. Name only that one: a header a proxy merely passes through would let a visitor choose their own country and rate-limit bucket."
msgstr "כותרות מועברות כבר מהימנות מפרוקסי מוכר, ורק X-Forwarded-For נקראת. ה-CDN שלך או שלא שולח את הכותרת הזו או שולח את שלו במקום, לכן ציין את הכותרת שהוא מחליף בכל בקשה. ציין רק את הכותרת הזו: כותרת שפרוקסי רק מעביר תאפשר למבקר לבחור את המדינה שלו ואת דלי מגבלת הקצב שלו."

#: inc/integrations/site-health/init.php:170
msgid "That header is correct for Cloudflare, whose edge ranges ship recognised. On any other CDN, substitute the header your provider documents as overwritten and add its published ranges through the surecookie_trusted_proxy_ips filter, or its forwarded header stays untrusted and nothing changes."
msgstr "כותרת זו נכונה עבור Cloudflare, שתחומי הקצה שלה מוכרים. בכל CDN אחר, החלף את הכותרת שספק השירות שלך מתעד ככותרת מוחלפת והוסף את התחומים שפורסמו דרך המסנן surecookie_trusted_proxy_ips, או שכותרת ההעברה שלו תישאר לא מהימנה ולא יקרה שינוי."

#: inc/integrations/site-health/init.php:180
msgid "Your reverse proxy is not passing the visitor address on at all. Prefer fixing it in the server, where every plugin benefits: with nginx, ngx_http_realip_module rewrites the peer address itself, so SureCookie needs no configuration."
msgstr "הפרוקסי ההפוך שלך אינו מעביר כלל את כתובת המבקר. עדיף לתקן זאת בשרת, שם כל תוסף נהנה: עם nginx, מודול ngx_http_realip_module משכתב את כתובת המקור בעצמו, כך ש-SureCookie אינו זקוק להגדרה."

#: inc/integrations/site-health/init.php:182
msgid "Passing the header to PHP works too, and needs nothing on the SureCookie side because a recognised proxy is already trusted:"
msgstr "העברת הכותרת ל-PHP גם עובדת, ואינה דורשת דבר בצד SureCookie כי פרוקסי מוכר כבר מהימן:"

#: inc/integrations/site-health/init.php:184
msgid "Use $proxy_add_x_forwarded_for, which appends. A proxy that relays the visitor's own X-Forwarded-For untouched leaves nothing to tell a forged value from a real one, which would let a visitor pick their own country and per-visitor rate-limit bucket."
msgstr "השתמש ב-$proxy_add_x_forwarded_for, שמוסיף. פרוקסי שמעביר את X-Forwarded-For של המבקר ללא שינוי אינו משאיר כל דרך להבדיל בין ערך מזויף לאמיתי, מה שיאפשר למבקר לבחור את המדינה שלו ואת דלי מגבלת הקצב שלו."

#: inc/integrations/site-health/init.php:134
msgid "Visitor address (direct)"
msgstr "כתובת מבקר (ישירה)"

#: inc/integrations/site-health/init.php:135
msgid "CDN edge address - forwarded headers not trusted"
msgstr "כתובת קצה CDN - כותרות מועברות אינן מהימנות"

#: inc/integrations/site-health/init.php:136
msgid "Reverse proxy address - forwarded headers not trusted"
msgstr "כתובת פרוקסי הפוך - כותרות מועברות אינן מהימנות"

