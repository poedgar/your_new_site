msgstr "ส่วนติดต่อผู้ใช้เนื้อหาที่ถูกบล็อก"

#: build/admin.js:2
#: build/admin.js:120
msgid "Import / Export"
msgstr "นำเข้า / ส่งออก"

#: build/admin.js:12
msgid "All dates"
msgstr "วันที่ทั้งหมด"

#: build/admin.js:12
msgid "Select date range"
msgstr "เลือกช่วงวันที่"

#: build/admin.js:12
msgid "Clear"
msgstr "ล้าง"

#: build/admin.js:39
msgid "Not In Use"
msgstr "ไม่ได้ใช้งาน"

#: build/admin.js:39
msgid "Hide Unused Categories"
msgstr "ซ่อนหมวดหมู่ที่ไม่ได้ใช้"

#: build/admin.js:39
msgid "Categories with no cookies, scripts, or services are hidden from the preferences modal. A category reappears automatically when usage changes, and is never removed from the consent record."
msgstr "หมวดหมู่ที่ไม่มีคุกกี้ สคริปต์ หรือบริการจะถูกซ่อนจากหน้าต่างการตั้งค่าความชอบ หมวดหมู่จะปรากฏขึ้นใหม่โดยอัตโนมัติเมื่อมีการเปลี่ยนแปลงการใช้งาน และจะไม่ถูกลบออกจากบันทึกความยินยอม"

#: build/admin.js:56
msgid "Failed to update category visibility"
msgstr "ไม่สามารถอัปเดตการแสดงผลหมวดหมู่ได้"

#: build/admin.js:69
msgid "This is a worldwide banner preview"
msgstr "นี่คือการแสดงตัวอย่างแบนเนอร์ทั่วโลก"

#: build/admin.js:96
msgid "Shows your default banner, the one visitors see when no Geographic Rule applies. Turning this on closes any rule preview."
