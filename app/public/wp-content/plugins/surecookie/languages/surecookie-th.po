msgstr "รายการบริการที่รู้จักที่ได้รับการยอมรับ - คลิก \"เพิ่มเป็นบริการ\" เพื่อประกาศคุกกี้ของมัน"

#: build/admin.js:97
msgid "Managed Service"
msgstr "บริการที่จัดการ"

#: build/admin.js:97
msgid "Known Service"
msgstr "บริการที่รู้จัก"

#: build/admin.js:97
msgid "Always Allowed"
msgstr "อนุญาตเสมอ"

#: build/admin.js:97
msgid "Category for"
msgstr "หมวดหมู่สำหรับ"

#: build/admin.js:97
msgid "Block until consent (recommended)"
msgstr "บล็อกจนกว่าจะได้รับความยินยอม (แนะนำ)"

#: build/admin.js:97
msgid "Edit Resource"
msgstr "แก้ไขทรัพยากร"

#: build/admin.js:97
msgid "Add Script or Embed"
msgstr "เพิ่มสคริปต์หรือฝัง"

#: build/admin.js:97
msgid "Update"
msgstr "อัปเดต"

#: build/admin.js:97
msgid "Behavior"
msgstr "พฤติกรรม"

#: build/admin.js:97
msgid "Whitelisted Resource Warning"
msgstr "คำเตือนทรัพยากรในรายการอนุญาต"

#: build/admin.js:97
msgid "If a resource sets cookies, allowing it directly can be a GDPR violation - only whitelist resources you are sure about."
msgstr "หากทรัพยากรกำหนดคุกกี้ การอนุญาตโดยตรงอาจละเมิด GDPR - ให้อนุญาตเฉพาะทรัพยากรที่คุณมั่นใจเท่านั้น"

#: build/admin.js:97
msgid "Detected by the scanner, so the value cannot be edited."
msgstr "ตรวจพบโดยเครื่องสแกน ดังนั้นค่าจึงไม่สามารถแก้ไขได้"

#: build/admin.js:97
msgid "e.g. Support chat"
msgstr "เช่น แชทสนับสนุน"

#: build/admin.js:97
msgid "Domain / Host"
msgstr "โดเมน / โฮสต์"

#: build/admin.js:97
msgid "e.g. connect.facebook.net"
msgstr "เช่น connect.facebook.net"

#: build/admin.js:97
msgid "The host the resource loads from. Pasting a full tag or URL also works."
msgstr "โฮสต์ที่ทรัพยากรโหลดจาก การวางแท็กหรือ URL เต็มรูปแบบก็ใช้ได้เช่นกัน"

#: build/admin.js:97
msgid "Path / Pattern (advanced)"
msgstr "เส้นทาง / รูปแบบ (ขั้นสูง)"

#: build/admin.js:97
msgid "e.g. /fbevents.js"
msgstr "เช่น /fbevents.js"

#: build/admin.js:97
msgid "Optional: narrow the rule to resources that also contain this path, so only one file on the host is blocked."
msgstr "ไม่บังคับ: จำกัดกฎให้แคบลงเฉพาะทรัพยากรที่มีเส้นทางนี้ด้วย เพื่อบล็อกไฟล์เดียวบนโฮสต์เท่านั้น"

#: build/admin.js:97
msgid "Script Keywords"
msgstr "คำสำคัญของสคริปต์"

#: build/admin.js:97
msgid "e.g. fbq, fbq.push"
msgstr "เช่น fbq, fbq.push"

#: build/admin.js:97
msgid "JavaScript function names to block that depend on the main script (comma separated)."
msgstr "ชื่อฟังก์ชัน JavaScript ที่จะบล็อกซึ่งขึ้นอยู่กับสคริปต์หลัก (คั่นด้วยเครื่องหมายจุลภาค)"

#: build/admin.js:97
msgid "Script Location"
msgstr "ตำแหน่งสคริปต์"

#: build/admin.js:97
msgid "Anywhere"
msgstr "ทุกที่"

#: build/admin.js:97
msgid "Where the script loads on the page. SureCookie only looks for it in this section."
msgstr "ตำแหน่งที่สคริปต์โหลดบนหน้า SureCookie จะค้นหาเฉพาะในส่วนนี้เท่านั้น"

#: build/admin.js:97
msgid "This resource stays blocked until the visitor consents to this category."
msgstr "ทรัพยากรนี้จะถูกบล็อกจนกว่าผู้เยี่ยมชมจะยินยอมในหมวดหมู่นี้"

#: build/admin.js:97
msgid "Unlock Whitelisting"
msgstr "ปลดล็อกการอนุญาตในรายการขาว"

#: build/admin.js:97
msgid "Whitelist your own scripts and common services so essential integrations keep working before consent."
msgstr "อนุญาตสคริปต์ของคุณเองและบริการทั่วไปเพื่อให้การรวมระบบที่จำเป็นทำงานได้ก่อนการยินยอม"

#. translators: %d: number of GCM-managed services.
#: build/admin.js:98
#, js-format
