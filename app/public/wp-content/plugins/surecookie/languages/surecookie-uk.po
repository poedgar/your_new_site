msgstr "Потрібні назва та категорія файлу cookie."

#: inc/services/cookie-service.php:727
msgid "Category not found in scanned cookies."
msgstr "Категорія не знайдена серед відсканованих файлів cookie."

#: inc/services/cookie-service.php:746
msgid "Cookie removed."
msgstr "Файл cookie видалено."

