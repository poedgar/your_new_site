msgstr "Аналітика"

#: build/admin.js:107
#: build/admin.js:113
msgid "Marketing"
msgstr "Маркетинг"

#: build/admin.js:107
msgid "What Changed in the Last Scan"
msgstr "Що змінилося під час останнього сканування"

#: build/admin.js:107
msgid "Cookies and tracker domains that changed compared to the previous scan."
msgstr "Куки та домени трекерів, які змінилися порівняно з попереднім скануванням."

#: build/admin.js:107
msgid "No differences were detected compared to the previous scan."
msgstr "Відмінностей порівняно з попереднім скануванням не виявлено."

#: build/admin.js:107
msgid "New Cookies"
msgstr "Нові куки"

#: build/admin.js:107
msgid "No Longer Detected"
msgstr "Більше не виявляються"

#: build/admin.js:107
msgid "Recategorized"
msgstr "Перекатегоризовано"

#: build/admin.js:107
msgid "New Tracker Domains"
msgstr "Нові домени трекерів"

#: build/admin.js:107
msgid "Third-party"
msgstr "Сторонні"

#: build/admin.js:107
msgid "Monthly"
msgstr "Щомісячно"

#: build/admin.js:107
msgid "Re-scan your site once a month."
msgstr "Повторне сканування вашого сайту раз на місяць."

#: build/admin.js:107
msgid "Weekly"
msgstr "Щотижня"

#: build/admin.js:107
msgid "Re-scan every week for faster drift detection."
msgstr "Повторне сканування щотижня для швидшого виявлення змін."

#: build/admin.js:107
msgid "Content from Manual Scan"
msgstr "Вміст із ручного сканування"

#: build/admin.js:107
msgid "Reuse the Manual scan selected content."
msgstr "Повторне використання вибраного вмісту ручного сканування."

#: build/admin.js:107
msgid "All Published Content"
msgstr "Весь опублікований вміст"

#: build/admin.js:107
msgid "Scan all published content, as per plan limit."
msgstr "Сканувати весь опублікований вміст відповідно до ліміту плану."

#: build/admin.js:107
msgid "Selected Content"
msgstr "Вибраний вміст"

#: build/admin.js:107
msgid "Choose specific content to scan below."
msgstr "Виберіть конкретний вміст для сканування нижче."

#: build/admin.js:107
msgid "Automatically re-scan your site and get notified when new cookies or trackers appear."
msgstr "Автоматично повторно скануйте свій сайт і отримуйте сповіщення, коли з’являються нові куки або трекери."

#: build/admin.js:107
msgid "Run scheduled scans in the background and detect changes automatically."
msgstr "Запускайте заплановані сканування у фоновому режимі та автоматично виявляйте зміни."

#: build/admin.js:107
msgid "Scan Frequency"
msgstr "Частота сканування"

#: build/admin.js:107
msgid "Content to Scan"
msgstr "Вміст для сканування"

#: build/admin.js:107
msgid "Select content to scan…"
msgstr "Виберіть вміст для сканування…"

#: build/admin.js:107
msgid "WordPress cron is disabled"
msgstr "Крон WordPress вимкнено"

#: build/admin.js:107
msgid "Scheduled scans rely on cron. Ask your host to set up a real server cron job so automatic scans run on time."
msgstr "Заплановані сканування залежать від cron. Попросіть вашого хостинг-провайдера налаштувати справжню серверну cron-задачу, щоб автоматичні сканування запускалися вчасно."

#: build/admin.js:107
msgid "Last Scan"
msgstr "Останнє сканування"

#. translators: %s: last scan date-time
#: build/admin.js:108
#, js-format
msgid "Scanned on %s"
msgstr "Скановано %s"

#: build/admin.js:108
msgid "Scheduled"
msgstr "Заплановано"

#. translators: %d: number of cookies found.
#: build/admin.js:109
#, js-format
msgid "%d Cookies Found"
msgstr "%d Кук знайдено"

#. translators: %d: number of new cookies
#: build/admin.js:110
#, js-format
msgid "%d New Cookies"
msgstr "%d Нових кук"

#. translators: %d: number of cookies no longer detected
#: build/admin.js:111
#, js-format
msgid "%d Removed"
msgstr "%d Видалено"

#. translators: %d: number of recategorized cookies
#: build/admin.js:112
#, js-format
msgid "%d Recategorized"
msgstr "%d Перекатегоризовано"

#. translators: %d: number of new tracker domains
#: build/admin.js:113
#, js-format
msgid "%d New Tracker Domains"
msgstr "%d Нових доменів трекерів"

#: build/admin.js:113
msgid "View Changes"
msgstr "Переглянути зміни"

#: build/admin.js:113
msgid "No scans yet - run your first scan to start monitoring changes."
msgstr "Сканувань ще не було — запустіть перше сканування, щоб почати відстежувати зміни."

#: build/admin.js:113
msgid "Stay Compliant Automatically"
msgstr "Автоматично дотримуйтесь вимог"

#: build/admin.js:113
msgid "Get weekly scans, instant alerts, smart classification, and automatic protection from new trackers."
msgstr "Отримуйте щотижневі сканування, миттєві сповіщення, розумну класифікацію та автоматичний захист від нових трекерів."

#: build/admin.js:113
msgid "Please enter at least one region code"
msgstr "Будь ласка, введіть принаймні один код регіону"

#: build/admin.js:113
msgid "Invalid region code format. Use ISO 3166 codes like EU, US, US-CA, or GB."
msgstr "Неправильний формат коду регіону. Використовуйте коди ISO 3166, такі як EU, US, US-CA або GB."

#: build/admin.js:113
msgid "EU/EEA (GDPR)"
msgstr "ЄС/ЄЕЗ (GDPR)"

#: build/admin.js:113
msgid "California (CCPA)"
msgstr "Каліфорнія (CCPA)"

#: build/admin.js:113
msgid "United Kingdom"
msgstr "Велика Британія"

#: build/admin.js:113
msgid "Brazil (LGPD)"
msgstr "Бразилія (LGPD)"

#: build/admin.js:113
msgid "Edit Worldwide Default"
msgstr "Редагувати світові налаштування за замовчуванням"

#: build/admin.js:113
msgid "Edit Regional Rule"
msgstr "Редагувати регіональне правило"

#: build/admin.js:113
msgid "Add Regional Rule"
msgstr "Додати регіональне правило"

#: build/admin.js:113
msgid "Set the default consent state for all visitors worldwide, before they make a choice. Regional rules override this for their regions, following each region’s law."
msgstr "Встановіть стан згоди за замовчуванням для всіх відвідувачів у світі, перш ніж вони зроблять вибір. Регіональні правила переважають для своїх регіонів відповідно до законів кожного регіону."

#: build/admin.js:113
msgid "Set default consent state for visitors from this region. Google uses the most specific match."
msgstr "Встановіть стан згоди за замовчуванням для відвідувачів із цього регіону. Google використовує найбільш конкретне співпадіння."

#: build/admin.js:113
#: build/admin.js:114
msgid "Add Rule"
msgstr "Додати правило"

#: build/admin.js:113
msgid "Quick Presets"
msgstr "Швидкі пресети"

#: build/admin.js:113
msgid "Apply preset:"
msgstr "Застосувати пресет:"

#: build/admin.js:113
msgid "Region Codes"
msgstr "Коди регіонів"

#: build/admin.js:113
msgid "Comma-separated ISO 3166 codes: EU, US, US-CA, GB, BR, etc."
msgstr "Коди ISO 3166, розділені комами: EU, US, US-CA, GB, BR тощо."

#: build/admin.js:113
msgid "Default Consent State"
msgstr "Стан згоди за замовчуванням"

#: build/admin.js:113
msgid "Choose which categories are granted by default for visitors from this region before they interact with the banner."
msgstr "Виберіть категорії, які надаються за замовчуванням для відвідувачів із цього регіону до їх взаємодії з банером."

#: build/admin.js:113
msgid "Functional Storage"
msgstr "Функціональне сховище"

#: build/admin.js:113
msgid "Enables storage for site functionality like preferences and language."
msgstr "Дозволяє зберігати дані для функціональності сайту, такі як налаштування та мова."

#: build/admin.js:113
msgid "Functional storage default"
msgstr "Функціональне сховище за замовчуванням"

#: build/admin.js:113
msgid "Analytics Storage"
msgstr "Аналітичне сховище"

#: build/admin.js:113
msgid "Enables storage for analytics purposes like visit duration and page views."
msgstr "Дозволяє зберігати дані для аналітики, такі як тривалість відвідування та перегляди сторінок."

#: build/admin.js:113
msgid "Analytics storage default"
msgstr "Аналітичне сховище за замовчуванням"

#: build/admin.js:113
msgid "Marketing / Ads Storage"
msgstr "Маркетингове / рекламне сховище"

#: build/admin.js:113
msgid "Enables storage for advertising purposes including ad personalization and user data."
msgstr "Дозволяє зберігати дані для рекламних цілей, включно з персоналізацією реклами та даними користувачів."

#: build/admin.js:113
msgid "Marketing storage default"
msgstr "Маркетингове сховище за замовчуванням"

#: build/admin.js:113
msgid "Essential cookies (security_storage) are always granted. These defaults apply before the visitor interacts with the consent banner."
msgstr "Основні файли cookie (security_storage) завжди надаються. Ці налаштування за замовчуванням застосовуються до взаємодії відвідувача з банером згоди."

#: build/admin.js:113
msgid "Granted"
msgstr "Надано"

#: build/admin.js:113
msgid "Denied"
msgstr "Відмовлено"

#: build/admin.js:113
msgid "Active Regional Rules"
msgstr "Активні регіональні правила"

#: build/admin.js:113
msgid "Set different default consent states per region. Google uses the most specific match (e.g., US-CA overrides US)."
msgstr "Встановіть різні стани згоди за замовчуванням для кожного регіону. Google використовує найбільш конкретне співпадіння (наприклад, US-CA замінює US)."

#: build/admin.js:113
msgid "Worldwide"
msgstr "Увесь світ"

#: build/admin.js:113
msgid "Edit worldwide default consent"
msgstr "Редагувати світову згоду за замовчуванням"

#: build/admin.js:113
msgid "Visitors are treated as consenting before they answer"
msgstr "Відвідувачів вважають такими, що надали згоду, поки вони не відповіли"

#. translators: %s: comma-separated consent category names, e.g. "Analytics, Marketing"
#: build/admin.js:114
#, js-format
msgid "The Worldwide default grants %s on the first page view, before the banner is answered. Google tags fire immediately, and a later Decline cannot recall what was already sent."
msgstr "Світова згода за замовчуванням надає %s при першому перегляді сторінки, до відповіді на банер. Теги Google запускаються негайно, і пізніша відмова не може відкликати вже надіслане."

#: build/admin.js:114
msgid "Edit rule for"
msgstr "Редагувати правило для"

#: build/admin.js:114
msgid "Delete rule for"
msgstr "Видалити правило для"

#: build/admin.js:114
msgid "No regional rules configured. The Worldwide default above applies to every visitor."
msgstr "Регіональні правила не налаштовані. Вищезазначена світова згода за замовчуванням застосовується до кожного відвідувача."

#. translators: %s: comma-separated duplicate region codes
#: build/admin.js:115
#, js-format
msgid "These region codes already exist in another rule: %s"
msgstr "Ці коди регіонів уже існують в іншому правилі: %s"

#: build/admin.js:115
msgid "Delete Regional Rule"
msgstr "Видалити регіональне правило"

#: build/admin.js:115
msgid "Are you sure you want to delete this regional consent rule? Visitors from this region will use the global default."
msgstr "Ви впевнені, що хочете видалити це регіональне правило згоди? Відвідувачі з цього регіону використовуватимуть глобальне значення за замовчуванням."

#: build/admin.js:115
msgid "Google Consent Mode v2"
msgstr "Режим згоди Google v2"

#: build/admin.js:115
msgid "Automatically communicate user consent preferences to Google services."
msgstr "Автоматично передавати налаштування згоди користувача сервісам Google."

#: build/admin.js:115
msgid "Enable Google Consent Mode Switch"
msgstr "Увімкнути перемикач режиму згоди Google"

#: build/admin.js:115
msgid "Enable Google Consent Mode"
msgstr "Увімкнути режим згоди Google"

#: build/admin.js:115
msgid "Supported services: Analytics 4, Google Ads, Tag Manager, Campaign Manager 360, Ad Manager, Floodlight, and DV360"
msgstr "Підтримувані сервіси: Analytics 4, Google Ads, Tag Manager, Campaign Manager 360, Ad Manager, Floodlight та DV360"

#: build/admin.js:115
msgid "Wait Time (milliseconds)"
msgstr "Час очікування (мілісекунди)"

#: build/admin.js:115
msgid "How long Google services wait for consent before making requests. Default: 500ms. Range: 0–2000ms."
msgstr "Як довго сервіси Google чекають на згоду перед надсиланням запитів. За замовчуванням: 500 мс. Діапазон: 0–2000 мс."

#: build/admin.js:115
msgid "Mandatory for EU/EEA as of March 2024"
msgstr "Обов’язково для ЄС/ЄЕЗ з березня 2024 року"

#: build/admin.js:115
msgid "Google now requires Consent Mode v2 for all websites using Google services in the European Economic Area."
msgstr "Google тепер вимагає режим згоди v2 для всіх вебсайтів, що використовують сервіси Google у Європейській економічній зоні."

#: build/admin.js:115
msgid "Learn more about Google Consent Mode v2 →"
msgstr "Дізнатися більше про режим згоди Google v2 →"

#: build/admin.js:115
msgid "Control what visitors see when third-party content (like videos or maps) is blocked until consent is given."
msgstr "Керуйте тим, що бачать відвідувачі, коли сторонній контент (наприклад, відео або карти) заблоковано до надання згоди."

#: build/admin.js:115
msgid "Use video thumbnails"
msgstr "Використовувати мініатюри відео"

#: build/admin.js:115
msgid "Use Video Thumbnails"
msgstr "Використовувати мініатюри відео"

#: build/admin.js:115
msgid "Show the video's own thumbnail (e.g. YouTube) on the placeholder. Note: this loads the thumbnail from the provider before consent."
msgstr "Показувати власну мініатюру відео (наприклад, YouTube) на заповнювачі. Примітка: мініатюра завантажується від провайдера до надання згоди."

#: build/admin.js:115
msgid "Upload Image"
msgstr "Завантажити зображення"

#: build/admin.js:115
msgid "Default Placeholder Image"
msgstr "Зображення-заповнювач за замовчуванням"

#: build/admin.js:115
msgid "Select Placeholder Image"
msgstr "Вибрати зображення-заповнювач"

#: build/admin.js:115
msgid "Use this image"
msgstr "Використати це зображення"

#: build/admin.js:115
msgid "Placeholder Text"
msgstr "Текст-заповнювач"

#: build/admin.js:115
msgid "Enter placeholder text"
msgstr "Введіть текст-заповнювач"

#: build/admin.js:115
msgid "Use {service} to insert the blocked service name (e.g. YouTube)."
msgstr "Використовуйте {service} для вставки назви заблокованої служби (наприклад, YouTube)."

#: build/admin.js:115
msgid "Button Text"
msgstr "Текст кнопки"

#: build/admin.js:115
msgid "Show your cookie banner only in regions where consent is required."
msgstr "Показуйте банер cookie лише в регіонах, де потрібна згода."

#: build/admin.js:115
