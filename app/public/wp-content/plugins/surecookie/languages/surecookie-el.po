msgid_plural "SureCookie recognised %d services on your site."
msgstr[0] "Το SureCookie αναγνώρισε %d υπηρεσία στον ιστότοπό σας."
msgstr[1] "Το SureCookie αναγνώρισε %d υπηρεσία στον ιστότοπό σας."

#. translators: %d: number of cookies the scan observed.
#: build/admin.js:78
#, js-format
msgid "This scan observed %d cookie."
msgid_plural "This scan observed %d cookies."
msgstr[0] "Αυτή η σάρωση παρατήρησε %d cookie."
msgstr[1] "Αυτή η σάρωση παρατήρησε %d cookie."

#: build/admin.js:78
msgid "Their cookies are already on your cookie policy, including any the scan could not see for itself, so a low cookie count does not mean the scan failed."
msgstr "Τα cookies τους είναι ήδη στην πολιτική cookies σας, συμπεριλαμβανομένων αυτών που η σάρωση δεν μπόρεσε να δει, οπότε ένας χαμηλός αριθμός cookies δεν σημαίνει ότι η σάρωση απέτυχε."

#: build/admin.js:78
msgid "Some Recognised Services Are Not Declared"
msgstr "Κάποιες Αναγνωρισμένες Υπηρεσίες Δεν Είναι Δηλωμένες"

#: build/admin.js:78
msgid "Services We Recognised"
msgstr "Υπηρεσίες που Αναγνωρίσαμε"

#. translators: %s: comma-separated service names.
#: build/admin.js:79
#, js-format
msgid "%s is marked as removed in your Known Services library, so its cookies are not on your cookie policy and scanning again will not add them."
msgid_plural "%s are marked as removed in your Known Services library, so their cookies are not on your cookie policy and scanning again will not add them."
msgstr[0] "%s έχει επισημανθεί ως αφαιρεμένη στη βιβλιοθήκη Γνωστών Υπηρεσιών σας, οπότε τα cookies της δεν είναι στην πολιτική cookies σας και η επανεξέταση δεν θα τα προσθέσει."
msgstr[1] "%s έχει επισημανθεί ως αφαιρεμένη στη βιβλιοθήκη Γνωστών Υπηρεσιών σας, οπότε τα cookies της δεν είναι στην πολιτική cookies σας και η επανεξέταση δεν θα τα προσθέσει."

#: build/admin.js:79
msgid "Open Known Services"
msgstr "Άνοιγμα Γνωστών Υπηρεσιών"

#: build/admin.js:97
msgid "Compliance Guard is holding this resource until you review it, so it does not load yet - not even for a visitor who has consented. Release it from Automatic Scanning, or set it to Always load here."
msgstr "Το Compliance Guard κρατά αυτόν τον πόρο μέχρι να τον εξετάσετε, οπότε δεν φορτώνει ακόμα - ούτε καν για επισκέπτη που έχει δώσει συγκατάθεση. Απελευθερώστε τον από την Αυτόματη Σάρωση ή ορίστε τον να φορτώνει πάντα εδώ."

#: build/admin.js:97
msgid "Held for review"
msgstr "Κρατείται για αναθεώρηση"

#: inc/utils/options.php:56
msgid "We use cookies to improve your experience. You can change your choice at any time."
msgstr "Χρησιμοποιούμε cookies για να βελτιώσουμε την εμπειρία σας. Μπορείτε να αλλάξετε την επιλογή σας οποιαδήποτε στιγμή."

#: build/admin.js:7
msgid "Keep it to about two lines on a phone. A longer message can become your page's Largest Contentful Paint (LCP) element and lower its PageSpeed score."
msgstr "Κρατήστε το μήνυμα περίπου σε δύο γραμμές σε κινητό. Ένα μεγαλύτερο μήνυμα μπορεί να γίνει το στοιχείο Largest Contentful Paint (LCP) της σελίδας σας και να μειώσει τη βαθμολογία PageSpeed της."

