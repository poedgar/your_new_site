msgstr "No se pudo iniciar el escaneo asistido"

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Please try again in a moment."
msgstr "Por favor, inténtelo de nuevo en un momento."

#: build/admin.js:82
#: build/onboarding.js:9
