msgstr "Su navegador bloqueó la ventana de escaneo"

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Allow pop-ups for this site, then start the scan again."
msgstr "Permita las ventanas emergentes para este sitio y luego inicie el escaneo nuevamente."

#: build/admin.js:83
msgid "View Scan Logs"
msgstr "Ver registros de escaneo"

#: build/admin.js:87
#: build/admin.js:96
msgid "Scan your website to find cookies, scripts, and trackers that require consent."
msgstr "Escanee su sitio web para encontrar cookies, scripts y rastreadores que requieran consentimiento."

#: build/admin.js:96
msgid "This is taking a little longer than usual"
msgstr "Esto está tomando un poco más de tiempo de lo habitual"

#: build/admin.js:96
msgid "A page is taking a while to respond, but your scan is still running in the background. Any cookies already found have been saved. You can leave this page and come back - or cancel and try again with fewer pages."
msgstr "Una página está tardando en responder, pero su escaneo sigue ejecutándose en segundo plano. Las cookies ya encontradas se han guardado. Puede salir de esta página y volver, o cancelar e intentar de nuevo con menos páginas."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Queued for Later"
msgstr "Escaneo en cola para más tarde"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Today's page budget is used up, so the remaining pages will scan automatically once it resets. Any cookies already found are saved. To scan sooner, run it again with fewer pages."
msgstr "El presupuesto de páginas de hoy se ha agotado, por lo que las páginas restantes se escanearán automáticamente una vez que se reinicie. Las cookies ya encontradas están guardadas. Para escanear antes, ejecútelo de nuevo con menos páginas."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Completed"
msgstr "No se pudo completar el escaneo"

