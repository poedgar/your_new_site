#: build/admin.js:79
#: build/onboarding.js:4
msgid "We Could Not Verify Your Domain"
msgstr "Chúng tôi không thể xác minh tên miền của bạn"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Verify With a DNS Record Instead"
msgstr "Xác minh bằng bản ghi DNS thay thế"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Add this TXT record at your DNS provider, then retry. This proves you own the domain without us needing to reach your site, so a firewall cannot block it."
msgstr "Thêm bản ghi TXT này tại nhà cung cấp DNS của bạn, sau đó thử lại. Điều này chứng minh bạn sở hữu tên miền mà không cần chúng tôi truy cập trang web của bạn, vì vậy tường lửa không thể chặn nó."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Domain verified"
msgstr "Tên miền đã được xác minh"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Still not verified"
msgstr "Vẫn chưa được xác minh"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes can take a while to propagate. Try again shortly."
msgstr "Thay đổi DNS có thể mất một thời gian để lan truyền. Hãy thử lại sau."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Retry Verification"
msgstr "Thử xác minh lại"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes usually apply within minutes, but can take up to a day."
msgstr "Thay đổi DNS thường áp dụng trong vài phút, nhưng có thể mất đến một ngày."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Session Expired"
msgstr "Phiên làm việc đã hết hạn"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your session or license changed since this page loaded. Reload the page to reconnect, then start the scan again."
msgstr "Phiên làm việc hoặc giấy phép của bạn đã thay đổi kể từ khi trang này được tải. Tải lại trang để kết nối lại, sau đó bắt đầu quét lại."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Site Verification Failed"
msgstr "Xác minh trang web thất bại"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scanning service could not reach your site to verify it. A firewall, security plugin, or SSL problem is the usual cause. Check those and try again."
msgstr "Dịch vụ quét không thể truy cập trang web của bạn để xác minh. Tường lửa, plugin bảo mật hoặc vấn đề SSL thường là nguyên nhân. Kiểm tra những điều đó và thử lại."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Couldn't Reach the Scanner"
msgstr "Không thể kết nối với bộ quét"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your site could not reach the scanning service. Check your connection and try again. Any cookies already found are saved."
msgstr "Trang web của bạn không thể kết nối với dịch vụ quét. Kiểm tra kết nối và thử lại. Bất kỳ cookie nào đã tìm thấy đều được lưu lại."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "No Pages Left to Scan"
msgstr "Không còn trang nào để quét"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The pages you selected are no longer published, so there was nothing to scan. Choose your pages again and start a new scan."
msgstr "Các trang bạn chọn không còn được xuất bản, nên không có gì để quét. Chọn lại các trang và bắt đầu quét mới."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Already Running"
msgstr "Quét đang chạy"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "A scan is already running on this site. Wait for it to finish, then start the next one. If nothing appears to be running, reload the page and try again."
msgstr "Một quá trình quét đang chạy trên trang này. Đợi nó hoàn thành rồi bắt đầu quét tiếp theo. Nếu không có gì chạy, hãy tải lại trang và thử lại."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Started"
msgstr "Không thể bắt đầu quét"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "SureCookie could not start the scan, usually a temporary problem reaching the scanning service. Any cookies already found are saved. Please try again in a moment."
msgstr "SureCookie không thể bắt đầu quét, thường do vấn đề tạm thời khi kết nối dịch vụ quét. Bất kỳ cookie nào đã tìm thấy đều được lưu lại. Vui lòng thử lại sau một lúc."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scan request was rejected before it started. Reload the page and try again."
msgstr "Yêu cầu quét bị từ chối trước khi bắt đầu. Tải lại trang và thử lại."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scanning Needs SureCookie Pro"
msgstr "Quét cần SureCookie Pro"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "This scan is a Pro feature. Upgrade to run it, or carry on with the cookies already found."
msgstr "Quét này là tính năng Pro. Nâng cấp để chạy hoặc tiếp tục với các cookie đã tìm thấy."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Daily Scan Limit Reached"
msgstr "Đã đạt giới hạn quét hàng ngày"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "You have used every scan allowed today. Any cookies already found are saved, and you can scan again once the limit resets."
msgstr "Bạn đã sử dụng hết số lần quét được phép hôm nay. Bất kỳ cookie nào đã tìm thấy đều được lưu lại, và bạn có thể quét lại khi giới hạn được đặt lại."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Any cookies already found have been saved, and results add up across scans, so nothing is lost. Please try again in a moment."
msgstr "Bất kỳ cookie nào đã tìm thấy đều được lưu lại, và kết quả cộng dồn qua các lần quét, nên không mất dữ liệu. Vui lòng thử lại sau một lúc."

