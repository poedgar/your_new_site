#: build/admin.js:107
#, js-format
msgid "Replace the %d block marked \"Replace this block\" with your own wording, then delete the marker."
msgid_plural "Replace the %d blocks marked \"Replace this block\" with your own wording, then delete the markers."
msgstr[0] "Erstat %d blok markeret \"Erstat denne blok\" med din egen tekst, og slet derefter markøren."
msgstr[1] "Erstat de %d blokke markeret \"Erstat denne blok\" med din egen tekst, og slet derefter markørerne."

#: build/admin.js:107
msgid "No \"Replace this block\" sections are left in the draft."
msgstr "Der er ingen \"Erstat denne blok\"-sektioner tilbage i udkastet."

#: build/admin.js:107
msgid "Finally have it reviewed by a qualified professional in your jurisdiction before publishing."
msgstr "Få det endelig gennemgået af en kvalificeret professionel i din jurisdiktion, før du offentliggør."

#: build/admin.js:107
msgid "Each section of the generated page is its own shortcode, so you can delete or reorder them, or drop them into a page you wrote yourself. They always render your current settings."
msgstr "Hver sektion af den genererede side er sin egen kortkode, så du kan slette eller omarrangere dem, eller indsætte dem på en side, du selv har skrevet. De gengiver altid dine aktuelle indstillinger."

