msgstr "(ingen titel)"

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Failed to initiate scan"
msgstr "Kunne ikke starte scanning"

#: build/admin.js:82
msgid "Scan Started!"
msgstr "Scanning startet!"

#: build/admin.js:82
msgid "Scanning your content for cookies. This may take a few minutes."
msgstr "Scanner dit indhold for cookies. Dette kan tage et par minutter."

#. translators: 1: pages scanned, 2: pages submitted
#: build/admin.js:83
#, js-format
msgid "Scanned %1$d of %2$d pages - your daily page budget is used up. The remaining pages will scan after it resets."
msgstr "Scannet %1$d af %2$d sider - dit daglige sidebudget er brugt op. De resterende sider scannes, når det nulstilles."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Session Expired"
msgstr "Session udløbet"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your session or license changed since this page loaded. Reload the page to reconnect, then start the scan again."
msgstr "Din session eller licens er ændret siden denne side blev indlæst. Genindlæs siden for at genoprette forbindelsen, og start scanningen igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Site Verification Failed"
msgstr "Webstedsverifikation mislykkedes"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scanning service could not reach your site to verify it. A firewall, security plugin, or SSL problem is the usual cause. Check those and try again."
msgstr "Scanningsservicen kunne ikke nå dit websted for at verificere det. En firewall, sikkerhedsplugin eller SSL-problem er den sædvanlige årsag. Tjek disse og prøv igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Couldn't Reach the Scanner"
msgstr "Kunne ikke nå scanneren"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your site could not reach the scanning service. Check your connection and try again. Any cookies already found are saved."
msgstr "Dit websted kunne ikke nå scanningsservicen. Tjek din forbindelse og prøv igen. Eventuelle allerede fundne cookies er gemt."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Queued for Later"
msgstr "Scanning sat i kø til senere"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Today's page budget is used up, so the remaining pages will scan automatically once it resets. Any cookies already found are saved. To scan sooner, run it again with fewer pages."
msgstr "Dagens sidebudget er brugt op, så de resterende sider scannes automatisk, når det nulstilles. Eventuelle allerede fundne cookies er gemt. For at scanne tidligere, kør det igen med færre sider."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "No Pages Left to Scan"
msgstr "Ingen sider tilbage at scanne"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The pages you selected are no longer published, so there was nothing to scan. Choose your pages again and start a new scan."
msgstr "De sider, du valgte, er ikke længere offentliggjort, så der var intet at scanne. Vælg dine sider igen og start en ny scanning."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Already Running"
msgstr "Scanning kører allerede"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "A scan is already running on this site. Wait for it to finish, then start the next one. If nothing appears to be running, reload the page and try again."
msgstr "En scanning kører allerede på dette websted. Vent på, at den bliver færdig, og start derefter den næste. Hvis der ikke ser ud til at køre noget, genindlæs siden og prøv igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Started"
msgstr "Scanning kunne ikke startes"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "SureCookie could not start the scan, usually a temporary problem reaching the scanning service. Any cookies already found are saved. Please try again in a moment."
msgstr "SureCookie kunne ikke starte scanningen, normalt et midlertidigt problem med at nå scanningsservicen. Eventuelle allerede fundne cookies er gemt. Prøv igen om et øjeblik."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scan request was rejected before it started. Reload the page and try again."
msgstr "Scanningsanmodningen blev afvist, før den startede. Genindlæs siden og prøv igen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scanning Needs SureCookie Pro"
msgstr "Scanning kræver SureCookie Pro"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "This scan is a Pro feature. Upgrade to run it, or carry on with the cookies already found."
msgstr "Denne scanning er en Pro-funktion. Opgrader for at køre den, eller fortsæt med de allerede fundne cookies."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Daily Scan Limit Reached"
msgstr "Dagligt scanningsloft nået"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "You have used every scan allowed today. Any cookies already found are saved, and you can scan again once the limit resets."
msgstr "Du har brugt alle tilladte scanninger i dag. Eventuelle allerede fundne cookies er gemt, og du kan scanne igen, når loftet nulstilles."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Completed"
msgstr "Scanning kunne ikke fuldføres"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Any cookies already found have been saved, and results add up across scans, so nothing is lost. Please try again in a moment."
msgstr "Eventuelle allerede fundne cookies er gemt, og resultaterne lægges sammen på tværs af scanninger, så intet går tabt. Prøv igen om et øjeblik."

