msgstr "Du har valgt mere end %d sider"

#. translators: %d: maximum pages
#: build/admin.js:81
#: build/onboarding.js:6
#, js-format
msgid "An assisted scan visits up to %d pages. Remove some pages to continue."
msgstr "En assisteret scanning besøger op til %d sider. Fjern nogle sider for at fortsætte."

#: build/admin.js:81
#: build/onboarding.js:6
msgid "Scanning in your browser…"
msgstr "Scanner i din browser…"

#: build/admin.js:81
#: build/onboarding.js:6
msgid "Start Browser Scan"
msgstr "Start browserscanning"

#: build/admin.js:81
#: build/onboarding.js:6
msgid "A new tab opens to scan your selected pages - keep it active until it finishes."
msgstr "En ny fane åbnes for at scanne dine valgte sider - hold den aktiv, indtil den er færdig."

#: build/admin.js:81
#: build/onboarding.js:6
msgid "Switch Back"
msgstr "Skift tilbage"

#: build/admin.js:81
msgid "This page did not load the scanner, so it was skipped. A redirect or a login requirement usually causes this."
msgstr "Denne side indlæste ikke scanneren, så den blev sprunget over. En omdirigering eller et login-krav forårsager normalt dette."

#: build/admin.js:81
msgid "This page took too long to respond."
msgstr "Denne side tog for lang tid om at svare."

#: build/admin.js:81
msgid "Skipped because the scan was cancelled."
msgstr "Sprunget over fordi scanningen blev afbrudt."

#: build/admin.js:81
msgid "This page could not be collected."
msgstr "Denne side kunne ikke indsamles."

#: build/admin.js:81
msgid "Pages In This Scan"
msgstr "Sider i denne scanning"

#. translators: 1: cookie count, 2: script count
#: build/admin.js:82
#, js-format
msgid "%1$d cookies, %2$d scripts"
msgstr "%1$d cookies, %2$d scripts"

#: build/admin.js:82
msgid "Collecting…"
msgstr "Indsamler…"

#: build/admin.js:82
msgid "Waiting"
msgstr "Venter"

#: build/admin.js:82
msgid "Re-scan"
msgstr "Genindlæs"

#: build/admin.js:82
#: build/onboarding.js:8
#: build/onboarding.js:9
msgid "Activate License"
msgstr "Aktivér licens"

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Consider Plan Upgrade"
msgstr "Overvej opgradering af plan"

#: build/admin.js:82
#: build/onboarding.js:1
msgid "Could not start the assisted scan."
msgstr "Kunne ikke starte den assisterede scanning."

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Could not start the assisted scan"
msgstr "Kunne ikke starte den assisterede scanning"

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Please try again in a moment."
msgstr "Prøv igen om et øjeblik."

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Your browser blocked the scan window"
msgstr "Din browser blokerede scanningsvinduet"

#: build/admin.js:82
#: build/onboarding.js:9
msgid "Allow pop-ups for this site, then start the scan again."
msgstr "Tillad pop-ups for dette websted, og start scanningen igen."

#: build/admin.js:5
#: build/admin.js:82
#: build/admin.js:99
#: build/admin.js:107
#: build/onboarding.js:9
