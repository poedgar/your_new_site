msgstr "Nogle sider kunne ikke analyseres"

#. translators: 1: scanned pages, 2: total pages, 3: failed pages
#: build/admin.js:76
#, js-format
msgid "Scanned %1$d of %2$d pages - %3$d could not be analyzed. The cookies we did find are saved, and results add up across scans, so you can re-run the scan to pick up the rest."
msgstr "Scannet %1$d af %2$d sider - %3$d kunne ikke analyseres. De cookies, vi fandt, er gemt, og resultaterne lægges sammen på tværs af scanninger, så du kan køre scanningen igen for at finde resten."

#: build/admin.js:76
msgid "Once the scan is complete, the cookies it found appear under <a>Cookies</a>, and the scripts and embeds under <b>Scripts and Embeds</b>."
msgstr "Når scanningen er færdig, vises de cookies, den fandt, under <a>Cookies</a>, og scripts og indlejrede elementer under <b>Scripts og indlejrede elementer</b>."

#: build/admin.js:76
msgid "Keep the scan tab in front until it finishes: browsers slow down background tabs."
msgstr "Hold scanningsfanen foran, indtil den er færdig: browsere bliver langsommere med baggrundsfaner."

#: build/admin.js:76
msgid "Pages already collected are saved, so closing the tab early keeps what it found."
msgstr "Sider, der allerede er indsamlet, gemmes, så hvis du lukker fanen tidligt, bevares det, den fandt."

#: build/admin.js:76
msgid "An ad blocker or privacy extension in this browser can hide trackers from the scan."
msgstr "En annonceblokering eller privatlivsudvidelse i denne browser kan skjule trackere fra scanningen."

#: build/admin.js:76
msgid "Your scan limit will reset tomorrow."
msgstr "Din scanningsgrænse nulstilles i morgen."

#: build/admin.js:76
msgid "The scan runs in the background - you can safely navigate away."
msgstr "Scanningen kører i baggrunden - du kan trygt navigere væk."

#: build/admin.js:76
msgid "Make sure your site is publicly accessible (not behind basic auth or maintenance mode)."
msgstr "Sørg for, at dit site er offentligt tilgængeligt (ikke bag grundlæggende godkendelse eller vedligeholdelsestilstand)."

#: build/admin.js:76
msgid "Check if a firewall or security plugin is blocking external requests to your site."
msgstr "Tjek om en firewall eller sikkerhedsplugin blokerer eksterne forespørgsler til dit site."

#: build/admin.js:76
msgid "Pages with heavy JavaScript may take longer to scan. If scanning fails repeatedly, try fewer pages."
msgstr "Sider med tung JavaScript kan tage længere tid at scanne. Hvis scanningen fejler gentagne gange, prøv færre sider."

#: build/admin.js:76
msgid "If issues persist, copy the logs and <a>contact our support team.</a>"
msgstr "Hvis problemerne fortsætter, kopier logfilerne og <a>kontakt vores supportteam.</a>"

#: build/admin.js:76
msgid "contact our support team"
msgstr "kontakt vores supportteam"

#: build/admin.js:76
msgid "If remote scanning fails, try Assisted Scanner method: <button></button>"
msgstr "Hvis fjernscanning fejler, prøv Assisted Scanner-metoden: <button></button>"

#: build/admin.js:76
msgid "Switch to Default Scanner"
msgstr "Skift til standardscanner"

#: build/admin.js:76
msgid "Switch to Assisted Scanner"
msgstr "Skift til Assisted Scanner"

#: build/admin.js:76
#: build/onboarding.js:4
msgid "Scan From This Browser"
msgstr "Scan fra denne browser"

#: build/admin.js:76
#: build/onboarding.js:4
msgid "Your host blocked the scanner"
msgstr "Din vært blokerede scanneren"

#: build/admin.js:76
#: build/onboarding.js:4
msgid "Your site's firewall or bot protection served our scanner a security challenge instead of your page, so the scan completed without results. This does not affect your visitors, only automated scanners. Allowlist the SureCookie scanner (or ask your host to) and run the scan again."
msgstr "Dit sites firewall eller botbeskyttelse gav vores scanner en sikkerhedsudfordring i stedet for din side, så scanningen blev gennemført uden resultater. Dette påvirker ikke dine besøgende, kun automatiserede scannere. Tillad SureCookie-scanneren (eller bed din vært om det) og kør scanningen igen."

#: build/admin.js:76
#: build/onboarding.js:4
msgid "Services we still detected on your site (via a first-party check):"
msgstr "Tjenester vi stadig opdagede på dit site (via en first-party kontrol):"

#: build/admin.js:76
#: build/onboarding.js:4
msgid "How to allowlist the scanner"
msgstr "Sådan tillader du scanneren"

#: build/admin.js:76
#: build/onboarding.js:4
msgid "No cookies found in this browser scan"
msgstr "Ingen cookies fundet i denne browserscanning"

#: build/admin.js:76
#: build/onboarding.js:4
msgid "We found services on your pages that your browser did not load, which usually means an ad blocker or privacy extension is active. Try again in a browser with extensions disabled, or add the cookies manually."
msgstr "Vi fandt tjenester på dine sider, som din browser ikke indlæste, hvilket normalt betyder, at en annonceblokering eller privatlivsudvidelse er aktiv. Prøv igen i en browser med deaktiverede udvidelser, eller tilføj cookies manuelt."

#: build/admin.js:76
#: build/onboarding.js:4
msgid "The scan visited your pages but no cookies were set. Some services only set cookies after a visitor accepts the banner, so they may not appear. You can also add cookies manually."
msgstr "Scanningen besøgte dine sider, men der blev ikke sat cookies. Nogle tjenester sætter kun cookies efter, at en besøgende accepterer banneret, så de kan mangle. Du kan også tilføje cookies manuelt."

#: build/admin.js:76
#: build/onboarding.js:4
msgid "No cookies found in this scan"
msgstr "Ingen cookies fundet i denne scanning"

#: build/admin.js:76
#: build/onboarding.js:4
msgid "The scanner reached your site but did not detect any cookies. Some services only set cookies after a visitor accepts the banner, so they may not appear in a scan. You can also add cookies manually."
msgstr "Scanneren nåede dit site, men opdagede ingen cookies. Nogle tjenester sætter kun cookies, efter en besøgende accepterer banneret, så de vises muligvis ikke i en scanning. Du kan også tilføje cookies manuelt."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Could not copy"
msgstr "Kunne ikke kopiere"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Copy the value manually."
msgstr "Kopier værdien manuelt."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "We Could Not Verify Your Domain"
msgstr "Vi kunne ikke bekræfte dit domæne"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Verify With a DNS Record Instead"
msgstr "Bekræft med en DNS-post i stedet"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Add this TXT record at your DNS provider, then retry. This proves you own the domain without us needing to reach your site, so a firewall cannot block it."
msgstr "Tilføj denne TXT-post hos din DNS-udbyder, og prøv igen. Dette beviser, at du ejer domænet, uden at vi behøver at tilgå dit site, så en firewall kan ikke blokere det."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Domain verified"
msgstr "Domæne bekræftet"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Still not verified"
msgstr "Stadig ikke bekræftet"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes can take a while to propagate. Try again shortly."
msgstr "DNS-ændringer kan tage lidt tid at slå igennem. Prøv igen om lidt."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Retry Verification"
msgstr "Prøv bekræftelse igen"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "DNS changes usually apply within minutes, but can take up to a day."
msgstr "DNS-ændringer træder normalt i kraft inden for få minutter, men kan tage op til en dag."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Scan from Your Browser (Best for this site)"
msgstr "Scan fra din browser (bedst for dette site)"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Scan from Your Browser"
msgstr "Scan fra din browser"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Our scanner couldn't fully access your site due to server restrictions. This method runs the scan directly in your browser, ensuring accurate detection without being blocked."
msgstr "Vores scanner kunne ikke få fuld adgang til dit site på grund af serverbegrænsninger. Denne metode kører scanningen direkte i din browser og sikrer nøjagtig detektion uden blokering."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Run the scan directly in your browser. This helps detect cookies, scripts, and embeds even when external scanners are blocked."
msgstr "Kør scanningen direkte i din browser. Dette hjælper med at opdage cookies, scripts og embeds, selv når eksterne scannere er blokeret."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Detects cookies, scripts, and embeds as your visitors would see them."
msgstr "Opdager cookies, scripts og embeds, som dine besøgende ville se dem."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Works even when hosting or firewall blocks external scans."
msgstr "Fungerer selv når hosting eller firewall blokerer eksterne scanninger."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Results appear automatically in your Tracking Manager."
msgstr "Resultater vises automatisk i din Tracking Manager."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Some advanced detections may still require a remote scan when available."
msgstr "Nogle avancerede detektioner kan stadig kræve en fjernscanning, når det er tilgængeligt."

#: build/admin.js:79
#: build/onboarding.js:4
msgid "How this works"
msgstr "Sådan fungerer det"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "Before You Start"
msgstr "Før du starter"

#: build/admin.js:79
#: build/onboarding.js:4
msgid "To measure cookie duration accurately, this scan temporarily clears cookies for your site in this browser (including your consent choice). Your WordPress login session is preserved, so you'll remain signed in."
msgstr "For at måle cookie-varighed nøjagtigt, rydder denne scanning midlertidigt cookies for dit site i denne browser (inklusive dit samtykkevalg). Din WordPress-login-session bevares, så du forbliver logget ind."

#. translators: %d: maximum pages
#: build/admin.js:80
#: build/admin.js:95
#: build/onboarding.js:5
#: build/onboarding.js:16
#, js-format
