#: build/admin.js:83
#: build/onboarding.js:16
msgid "Session Expired"
msgstr "Sitzung abgelaufen"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your session or license changed since this page loaded. Reload the page to reconnect, then start the scan again."
msgstr "Ihre Sitzung oder Lizenz hat sich geändert, seit diese Seite geladen wurde. Laden Sie die Seite neu, um die Verbindung wiederherzustellen, und starten Sie den Scan erneut."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Site Verification Failed"
msgstr "Website-Verifizierung fehlgeschlagen"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scanning service could not reach your site to verify it. A firewall, security plugin, or SSL problem is the usual cause. Check those and try again."
msgstr "Der Scan-Dienst konnte Ihre Website nicht erreichen, um sie zu verifizieren. Eine Firewall, ein Sicherheits-Plugin oder ein SSL-Problem ist meist die Ursache. Überprüfen Sie diese und versuchen Sie es erneut."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Couldn't Reach the Scanner"
msgstr "Scanner konnte nicht erreicht werden"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your site could not reach the scanning service. Check your connection and try again. Any cookies already found are saved."
msgstr "Ihre Website konnte den Scan-Dienst nicht erreichen. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut. Bereits gefundene Cookies werden gespeichert."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "No Pages Left to Scan"
msgstr "Keine Seiten mehr zum Scannen"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The pages you selected are no longer published, so there was nothing to scan. Choose your pages again and start a new scan."
msgstr "Die von Ihnen ausgewählten Seiten sind nicht mehr veröffentlicht, daher gab es nichts zu scannen. Wählen Sie Ihre Seiten erneut aus und starten Sie einen neuen Scan."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Already Running"
msgstr "Scan läuft bereits"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "A scan is already running on this site. Wait for it to finish, then start the next one. If nothing appears to be running, reload the page and try again."
msgstr "Ein Scan läuft bereits auf dieser Website. Warten Sie, bis er abgeschlossen ist, und starten Sie dann den nächsten. Wenn kein Scan läuft, laden Sie die Seite neu und versuchen Sie es erneut."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Couldn't Be Started"
msgstr "Scan konnte nicht gestartet werden"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "SureCookie could not start the scan, usually a temporary problem reaching the scanning service. Any cookies already found are saved. Please try again in a moment."
msgstr "SureCookie konnte den Scan nicht starten, meist ein temporäres Problem beim Erreichen des Scan-Dienstes. Bereits gefundene Cookies werden gespeichert. Bitte versuchen Sie es in Kürze erneut."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scan request was rejected before it started. Reload the page and try again."
msgstr "Die Scan-Anfrage wurde abgelehnt, bevor sie gestartet wurde. Laden Sie die Seite neu und versuchen Sie es erneut."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scanning Needs SureCookie Pro"
msgstr "Scan benötigt SureCookie Pro"

#: build/admin.js:83
#: build/onboarding.js:16
