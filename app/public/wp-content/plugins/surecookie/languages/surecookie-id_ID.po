msgstr "Informasi hukum"

#: build/admin.js:66
#: build/public.js:1
msgid "Data recipients"
msgstr "Penerima data"

#: build/admin.js:66
#: build/public.js:1
msgid "Transferred outside the EU/EEA"
msgstr "Ditransfer ke luar UE/EEA"

#: build/admin.js:96
#: build/onboarding.js:6
msgid "Scanning is paused on this site"
msgstr "Pemindaian dijeda di situs ini"

#: build/admin.js:96
#: build/onboarding.js:6
msgid "Your site's built-in scheduler (WP-Cron) is switched off, and SureCookie needs it to run a scan. Ask your host to turn WP-Cron back on, or to add a server cron job. Everything else works normally, and you can scan as soon as it is back."
msgstr "Penjadwal bawaan situs Anda (WP-Cron) dimatikan, dan SureCookie membutuhkannya untuk menjalankan pemindaian. Minta penyedia hosting Anda untuk mengaktifkan kembali WP-Cron, atau menambahkan pekerjaan cron server. Semua fungsi lain berjalan normal, dan Anda dapat memindai segera setelah aktif kembali."

#: build/admin.js:99
msgid "Linked from the preferences modal, so visitors can reach it while the consent prompt is open. Order and visibility live under Banner > Content."
msgstr "Ditautkan dari modal preferensi, sehingga pengunjung dapat mengaksesnya saat prompt persetujuan terbuka. Urutan dan visibilitas diatur di Banner > Konten."

#: build/admin.js:102
msgid "Leave it empty if none of them applies."
msgstr "Biarkan kosong jika tidak ada yang berlaku."

#: build/onboarding.js:6
msgid "Your session has expired. Reload the page, then activate your license again."
msgstr "Sesi Anda telah kedaluwarsa. Muat ulang halaman, lalu aktifkan lisensi Anda lagi."

#: build/onboarding.js:6
msgid "We couldn't find that license key. Check it for typos, or copy it again from your SureCookie account."
msgstr "Kami tidak dapat menemukan kunci lisensi itu. Periksa kesalahan ketik, atau salin lagi dari akun SureCookie Anda."

#: build/onboarding.js:6
msgid "That license has expired. Renew it in your SureCookie account, then activate again."
msgstr "Lisensi itu telah kedaluwarsa. Perbarui di akun SureCookie Anda, lalu aktifkan lagi."

#: build/onboarding.js:6
msgid "That license is already active on the maximum number of sites. Deactivate it on a site you no longer use, or upgrade your plan."
msgstr "Lisensi itu sudah aktif di jumlah maksimum situs. Nonaktifkan di situs yang tidak Anda gunakan lagi, atau tingkatkan paket Anda."

#: build/onboarding.js:6
msgid "Visiting your pages…"
msgstr "Mengunjungi halaman Anda…"

#: build/onboarding.js:6
msgid "Sorting the cookies we found…"
msgstr "Mengurutkan cookie yang kami temukan…"

#: build/onboarding.js:6
msgid "Preparing the scan…"
msgstr "Mempersiapkan pemindaian…"

#. translators: 1: pages scanned so far, 2: total pages
#: build/onboarding.js:7
#, js-format
msgid "%1$d of %2$d pages"
msgstr "%1$d dari %2$d halaman"

#: build/onboarding.js:7
msgid "This runs on our servers, so you can continue setup now. The scan keeps going in the background and the results appear under Tracking Manager when it finishes."
msgstr "Ini berjalan di server kami, jadi Anda dapat melanjutkan pengaturan sekarang. Pemindaian terus berjalan di latar belakang dan hasilnya akan muncul di bawah Pengelola Pelacakan saat selesai."

#: build/onboarding.js:7
msgid "Stopping…"
msgstr "Menghentikan…"

#: build/onboarding.js:7
msgid "Stop Scan"
msgstr "Hentikan Pemindaian"

#: build/onboarding.js:7
msgid "Collecting the results…"
msgstr "Mengumpulkan hasil…"

#. translators: %d: number of cookies found
#: build/onboarding.js:8
#, js-format
msgid "We found %d cookie on your site"
msgid_plural "We found %d cookies on your site"
msgstr[0] "Kami menemukan %d cookie di situs Anda"
msgstr[1] "Kami menemukan %d cookie di situs Anda"

#: build/onboarding.js:8
msgid "Each one is sorted into a category so the banner can hold it back until a visitor agrees. You can review and change any of this later under Tracking Manager."
msgstr "Masing-masing diurutkan ke dalam kategori sehingga banner dapat menahannya sampai pengunjung menyetujuinya. Anda dapat meninjau dan mengubah ini kapan saja di bawah Pengelola Pelacakan."

#: build/onboarding.js:9
msgid "Connect your account instead"
msgstr "Hubungkan akun Anda sebagai gantinya"

#: build/onboarding.js:13
msgid "Your Privacy Scan"
msgstr "Pemindaian Privasi Anda"

#: build/onboarding.js:13
msgid "SureCookie is checking the pages you chose."
msgstr "SureCookie sedang memeriksa halaman yang Anda pilih."

#: build/onboarding.js:13
msgid "This is what SureCookie found on the pages you chose."
msgstr "Ini adalah apa yang SureCookie temukan di halaman yang Anda pilih."

#: build/onboarding.js:13
msgid "Please <a>go back</a> and add your license key, or connect your SureCookie account, to enable cookie scanning."
msgstr "Silakan <a>kembali</a> dan tambahkan kunci lisensi Anda, atau hubungkan akun SureCookie Anda, untuk mengaktifkan pemindaian cookie."

#: build/onboarding.js:16
msgid "Continue"
msgstr "Lanjutkan"

#: build/onboarding.js:16
msgid "SureCookie is visiting your selected pages. The results appear here as soon as it finishes."
msgstr "SureCookie sedang mengunjungi halaman yang Anda pilih. Hasilnya akan muncul di sini segera setelah selesai."

#: build/onboarding.js:16
msgid "Add a Cookie Preferences link"
msgstr "Tambahkan tautan Preferensi Cookie"

#: build/onboarding.js:16
msgid "Your theme has no classic menus, so add this shortcode to a footer block or widget area:"
msgstr "Tema Anda tidak memiliki menu klasik, jadi tambahkan shortcode ini ke blok footer atau area widget:"

#: build/onboarding.js:16
msgid "Copy the shortcode manually"
msgstr "Salin shortcode secara manual"

#: build/onboarding.js:16
msgid "Copy Shortcode"
msgstr "Salin Shortcode"
