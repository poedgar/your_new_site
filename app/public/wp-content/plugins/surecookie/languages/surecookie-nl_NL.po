msgstr "DNS-wijzigingen worden meestal binnen enkele minuten toegepast, maar kunnen tot een dag duren."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Session Expired"
msgstr "Sessie verlopen"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your session or license changed since this page loaded. Reload the page to reconnect, then start the scan again."
msgstr "Uw sessie of licentie is gewijzigd sinds deze pagina werd geladen. Herlaad de pagina om opnieuw verbinding te maken en start de scan opnieuw."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Site Verification Failed"
msgstr "Siteverificatie mislukt"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The scanning service could not reach your site to verify it. A firewall, security plugin, or SSL problem is the usual cause. Check those and try again."
msgstr "De scanservice kon uw site niet bereiken om deze te verifiëren. Een firewall, beveiligingsplugin of SSL-probleem is meestal de oorzaak. Controleer deze en probeer het opnieuw."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Couldn't Reach the Scanner"
msgstr "Kon de scanner niet bereiken"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Your site could not reach the scanning service. Check your connection and try again. Any cookies already found are saved."
msgstr "Uw site kon de scanservice niet bereiken. Controleer uw verbinding en probeer het opnieuw. Alle reeds gevonden cookies zijn opgeslagen."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "No Pages Left to Scan"
msgstr "Geen pagina's meer om te scannen"

#: build/admin.js:83
#: build/onboarding.js:16
msgid "The pages you selected are no longer published, so there was nothing to scan. Choose your pages again and start a new scan."
msgstr "De pagina's die u hebt geselecteerd zijn niet langer gepubliceerd, dus er was niets om te scannen. Kies uw pagina's opnieuw en start een nieuwe scan."

#: build/admin.js:83
#: build/onboarding.js:16
msgid "Scan Already Running"
msgstr "Scan is al bezig"

