#: inc/analyzer/seo-analyzer.php:903
#, php-format
msgid "From the SureRank Dashboard, go to General ⇾ Home Page ⇾ <a href='%1$s' target='_blank' rel='noopener'>%2$s</a>"
msgstr "Dalla Dashboard di SureRank, vai su Generale ⇾ Homepage ⇾ <a href='%1$s' target='_blank' rel='noopener'>%2$s</a>"

