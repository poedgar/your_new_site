msgid "Indicate the general pricing level using currency symbols (e.g., $, $$, $$$) or a numerical range (e.g., $10-50)."
msgstr "Indiquez le niveau de prix général en utilisant des symboles monétaires (par exemple, $, $$, $$$) ou une plage numérique (par exemple, 10-50 $)."

#: inc/schema/types/organization.php:451
msgid "Accepts reservations"
msgstr "Accepte les réservations"

