 something unexpected happened. Please try refreshing the page.":["\u6211\u4eec\u5f88\u62b1\u6b49\uff0c\u53d1\u751f\u4e86\u610f\u60f3\u4e0d\u5230\u7684\u4e8b\u60c5\u3002\u8bf7\u5c1d\u8bd5\u5237\u65b0\u9875\u9762\u3002"],"Try Again":["\u518d\u8bd5\u4e00\u6b21"],"Reload Page":["\u91cd\u65b0\u52a0\u8f7d\u9875\u9762"],"Error Details (Development Mode)":["\u9519\u8bef\u8be6\u60c5\uff08\u5f00\u53d1\u6a21\u5f0f\uff09"],"Error:":["\u9519\u8bef\uff1a"],"Component Stack:":["\u7ec4\u4ef6\u5806\u6808\uff1a"],"There was an error loading the %s page. Please try refreshing the page.":["\u52a0\u8f7d %s \u9875\u9762\u65f6\u51fa\u9519\u3002\u8bf7\u5c1d\u8bd5\u5237\u65b0\u9875\u9762\u3002"],"Oops! Something went wrong":["\u7cdf\u7cd5\uff01\u51fa\u4e86\u70b9\u95ee\u9898"],"We encountered an error while loading the %s page. This might be a temporary issue.":["\u52a0\u8f7d %s \u9875\u9762\u65f6\u9047\u5230\u9519\u8bef\u3002\u8fd9\u53ef\u80fd\u662f\u4e00\u4e2a\u4e34\u65f6\u95ee\u9898\u3002"],"Refresh Page":["\u5237\u65b0\u9875\u9762"],"Error loading %s":["\u52a0\u8f7d %s \u65f6\u51fa\u9519"],"Unable to load %s":["\u65e0\u6cd5\u52a0\u8f7d %s"],"There was an error loading the %s. Please try again.":["\u52a0\u8f7d %s \u65f6\u51fa\u9519\u3002\u8bf7\u518d\u8bd5\u4e00\u6b21\u3002"],"Failed to load %s. Please check your connection and try again.":["\u52a0\u8f7d %s \u5931\u8d25\u3002\u8bf7\u68c0\u67e5\u60a8\u7684\u8fde\u63a5\u5e76\u91cd\u8bd5\u3002"],"We're having trouble loading the %s. This could be due to a network issue or server problem.":["\u6211\u4eec\u5728\u52a0\u8f7d %s \u65f6\u9047\u5230\u95ee\u9898\u3002\u8fd9\u53ef\u80fd\u662f\u7531\u4e8e\u7f51\u7edc\u95ee\u9898\u6216\u670d\u52a1\u5668\u6545\u969c\u3002"],"Retry":["\u91cd\u8bd5"],"Search lists\u2026":["\u641c\u7d22\u5217\u8868\u2026"],"Select lists":["\u9009\u62e9\u5217\u8868"],"Error syncing lists and tags":["\u540c\u6b65\u5217\u8868\u548c\u6807\u7b7e\u65f6\u51fa\u9519"],"List \"%s\" created successfully!":["\u5217\u8868 \"%s\" \u521b\u5efa\u6210\u529f\uff01"],"No lists found for":["\u672a\u627e\u5230\u5217\u8868"],"No lists available":["\u6ca1\u6709\u53ef\u7528\u7684\u5217\u8868"],"Sync Lists & Tags":["\u540c\u6b65\u5217\u8868\u548c\u6807\u7b7e"],"Bulk Sync":["\u6279\u91cf\u540c\u6b65"],"Settings":["\u8bbe\u7f6e"],"Logs":["\u65e5\u5fd7"],"Open navigation menu":["\u6253\u5f00\u5bfc\u822a\u83dc\u5355"],"Go to dashboard":["\u8f6c\u5230\u4eea\u8868\u677f"],"Main navigation":["\u4e3b\u5bfc\u822a"],"V %s":["V %s"],"Account created!":["\u8d26\u6237\u521b\u5efa\u6210\u529f\uff01"],"Connecting your site to SureContact\u2026":["\u6b63\u5728\u5c06\u60a8\u7684\u7f51\u7ad9\u8fde\u63a5\u5230 SureContact\u2026"],"This email already has an account.":["\u8be5\u7535\u5b50\u90ae\u4ef6\u5df2\u62e5\u6709\u4e00\u4e2a\u8d26\u6237\u3002"],"Use the \u201cSign in\u201d link below to connect this site.":["\u8bf7\u4f7f\u7528\u4e0b\u9762\u7684\u201c\u767b\u5f55\u201d\u94fe\u63a5\u8fde\u63a5\u8be5\u7f51\u7ad9\u3002"],"We couldn\u2019t reach your site to verify the install.":["\u6211\u4eec\u65e0\u6cd5\u8bbf\u95ee\u60a8\u7684\u7f51\u7ad9\u4ee5\u9a8c\u8bc1\u5b89\u88c5\u3002"],"Check that your site is publicly accessible and try again.":["\u8bf7\u68c0\u67e5\u60a8\u7684\u7f51\u7ad9\u662f\u5426\u53ef\u4ee5\u516c\u5f00\u8bbf\u95ee\uff0c\u7136\u540e\u91cd\u8bd5\u3002"],"That email address isn\u2019t valid.":["\u8be5\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u65e0\u6548\u3002"],"Too many attempts.":["\u5c1d\u8bd5\u6b21\u6570\u8fc7\u591a\u3002"],"Please wait a minute and try again.":["\u8bf7\u7b49\u4e00\u5206\u949f\u518d\u8bd5\u3002"],"Something went wrong.":["\u51fa\u4e86\u70b9\u95ee\u9898\u3002"],"Please try again.":["\u8bf7\u518d\u8bd5\u4e00\u6b21\u3002"],"First name is required.":["\u5fc5\u586b\u540d\u4e0d\u80fd\u4e3a\u7a7a\u3002"],"Must be 60 characters or fewer.":["\u5fc5\u987b\u5c11\u4e8e60\u4e2a\u5b57\u7b26\u3002"],"Last name is required.":["\u5fc5\u586b\u59d3\u4e0d\u80fd\u4e3a\u7a7a\u3002"],"Email is required.":["\u5fc5\u586b\u90